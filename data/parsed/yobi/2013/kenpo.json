  {
   "id": "yobi-2013-kenpo-q12",
   "number": 12,
   "points": 2,
   "format": "mark_combination",
   "polarity": null,
   "exhaustive": false,
   "unordered": false,
   "stem": "憲法の最高法規性に関する次のアからウまでの各記述について，正しいものには○を，誤っているものには×を付した場合の組合せを，後記１から８までの中から選びなさい。（解答欄は，［№24］）",
   "context": [],
   "requires_context": false,
   "statements": [
    {
     "id": "yobi-2013-kenpo-q12-a",
     "label": "ア",
     "text": "憲法が最高法規であることからすれば，立法その他の国家行為が憲法に反するか否かを判断する権限が司法府に与えられていなければならない。",
     "line_range": [
      193,
      194
     ]
    },
    {
     "id": "yobi-2013-kenpo-q12-b",
     "label": "イ",
     "text": "憲法は授権するのみで授権されることはないため，実定法秩序における法の段階構造を前提にすれば，憲法の最高規範性が導き出される。",
     "line_range": [
      195,
      196
     ]
    },
    {
     "id": "yobi-2013-kenpo-q12-c",
     "label": "ウ",
     "text": "憲法の最高法規性は憲法規範の内容が他の法規範とは質的に異なることから導かれるが，このような意味における最高法規性が一般に実質的最高法規性と呼ばれている。",
     "line_range": [
      197,
      198
     ]
    }
   ],
