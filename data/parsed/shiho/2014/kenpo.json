      235
     ]
    },
    {
     "id": "shiho-2014-kenpo-q14-b",
     "label": "イ",
     "text": "各選挙区において選出された議員は，「全国民の代表」となるので，選挙区民から法的に責任を問われることはない。",
     "line_range": [
      236,
      237
     ]
    },
    {
     "id": "shiho-2014-kenpo-q14-c",
     "label": "ウ",
     "text": "議員が実質的には政党の媒介によってのみ国民代表者となり得るとする見解に立つと，党議拘束の慣行は，議員が「全国民の代表」であることと矛盾抵触する。",
     "line_range": [
      238,
      239
     ]
    }
