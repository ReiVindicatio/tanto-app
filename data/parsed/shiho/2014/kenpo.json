  {
   "id": "shiho-2014-kenpo-q08",
   "number": 8,
   "points": 2,
   "format": "mark_combination",
   "polarity": null,
   "exhaustive": false,
   "unordered": false,
   "stem": "学問の自由や大学の自治に関する次のアからウまでの各記述について，正しいものには○，誤っているものには×を付した場合の組合せを，後記１から８までの中から選びなさい。（解答欄は，[№14］）",
   "context": [],
   "requires_context": false,
   "statements": [
    {
     "id": "shiho-2014-kenpo-q08-a",
     "label": "ア",
     "text": "教授の自由の保障は，その沿革上，高等教育の場である大学に限られ，普通教育の場における教師の教授の自由は，学問の自由やその他の憲法上の自由として保障されているわけではない。",
     "line_range": [
      134,
      136
     ]
    },
    {
     "id": "shiho-2014-kenpo-q08-b",
     "label": "イ",
     "text": "大学は，自治権を有し，その施設及び学生の管理に関して自主的に決定する権利を有することから，警察は，大学の了解なしには大学構内において令状に基づく犯罪捜査を行うことはできない。",
     "line_range": [
      137,
      139
     ]
    },
    {
     "id": "shiho-2014-kenpo-q08-c",
     "label": "ウ",
     "text": "大学教授が授業中に行ったその所属学部の執行部への批判を理由として，当該学部が当該教授の授業開講を認めない措置を採るような場合には，学問の自由と大学の自治とが対立的な関係に立つ。",
     "line_range": [
      140,
      142
     ]
    }
   ],
