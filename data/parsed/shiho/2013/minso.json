  {
   "id": "shiho-2013-minso-q57",
   "number": 57,
   "points": 2,
   "format": "single_choice",
   "polarity": "incorrect",
   "exhaustive": false,
   "unordered": false,
   "stem": "訴訟能力に関する次の１から５までの各記述のうち，誤っているものはどれか。（解答欄は，［№60］）",
   "context": [],
   "requires_context": false,
   "statements": [
    {
     "id": "shiho-2013-minso-q57-1",
     "label": "１",
     "text": "成年被後見人が自らした訴訟行為は，取り消すことができる。",
     "line_range": [
      1103,
      1103
     ]
    },
    {
     "id": "shiho-2013-minso-q57-2",
     "label": "２",
     "text": "婚姻している未成年者は，自ら訴訟行為をすることができる。",
     "line_range": [
      1104,
      1104
     ]
    },
    {
     "id": "shiho-2013-minso-q57-3",
     "label": "３",
     "text": "未成年者は，人事訴訟においては，意思能力を有する限り，自ら訴訟行為をすることができる。",
     "line_range": [
      1105,
      1106
     ]
    },
    {
     "id": "shiho-2013-minso-q57-4",
     "label": "４",
     "text": "被保佐人が相手方の提起した訴えにおいて請求原因事実を認める旨の陳述をするには，保佐人の同意を要しない。",
     "line_range": [
      1107,
      1108
     ]
    },
    {
     "id": "shiho-2013-minso-q57-5",
     "label": "５",
     "text": "家庭裁判所は，被補助人が訴訟行為をするには補助人の同意を要する旨の審判をすることができる。",
     "line_range": [
      1109,
      1110
     ]
    }
   ],
