   }
  },
  {
   "id": "yobi-2019-gyosei-q13-b",
   "question_id": "yobi-2019-gyosei-q13",
   "label": "イ",
   "text": "公営住宅の使用関係については，事業主体と入居者との間の法律関係が，基本的には私人間の家屋賃貸借関係と異なるところはないとしても，民法及び借地借家法は適用されない。",
   "requires_context": false,
   "truth_at_exam": null,
   "truth_current": {
    "status": "unreviewed",
    "value": null,
    "basis": null,
    "law_change_refs": [],
    "reviewed_by": null,
    "reviewed_at": null
   },
   "tags": {
    "articles": [],
    "topics": []
   },
   "provenance": {
    "line_range": [
     290,
     291
    ]
   }
  },
  {
   "id": "yobi-2019-gyosei-q13-c",
   "question_id": "yobi-2019-gyosei-q13",
   "label": "ウ",
   "text": "国税滞納処分における国の地位は，民事上の強制執行における差押債権者の地位に類するものであるから，国税滞納処分による差押えの関係においても民法第１７７条の適用がある。",
   "requires_context": false,
   "truth_at_exam": null,
   "truth_current": {
    "status": "unreviewed",
    "value": null,
    "basis": null,
    "law_change_refs": [],
