       "no": 27,
       "official_answer": 2
      }
     ]
    }
   },
   "truth_current": {
    "status": "unreviewed",
    "value": null,
    "basis": null,
    "law_change_refs": [],
    "reviewed_by": null,
    "reviewed_at": null
   },
   "tags": {
