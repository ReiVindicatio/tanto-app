 "statements": [
  {
   "id": "yobi-2019-gyosei-q13-a",
   "question_id": "yobi-2019-gyosei-q13",
   "label": "ア",
   "text": "国家公務員の災害補償について国家公務員法や国家公務員災害補償法等に詳細な定めが置かれていることからすると，国が国家公務員に対して，安全配慮義務違反に基づく損害賠償責任を負うとはいえない。",
   "requires_context": false,
   "truth_at_exam": null,
   "truth_current": {
    "status": "unreviewed",
