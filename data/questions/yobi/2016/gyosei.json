  },
  {
   "id": "yobi-2016-gyosei-q14-b",
   "question_id": "yobi-2016-gyosei-q14",
   "label": "イ",
   "text": "Ｂに対する不利益処分の発動に強い関心を持っているライバル事業者Ｃは，聴聞手続において，Ａ県知事に対し，当該処分の原因となる事実を証する資料の閲覧を求めることができる。",
   "requires_context": false,
   "truth_at_exam": null,
   "truth_current": {
