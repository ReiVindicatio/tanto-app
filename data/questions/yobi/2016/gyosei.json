  },
  {
   "id": "yobi-2016-gyosei-q13-c",
   "question_id": "yobi-2016-gyosei-q13",
   "label": "ウ",
   "text": "本判決は，薬事法の規定の趣旨を考慮する際には，薬事法の立法過程で一般用医薬品を店舗において対面で販売する必要性が強調されていたなどの立法過程における議論を考慮してはならないとしたものである。[№27]",
   "requires_context": true,
   "truth_at_exam": {
    "value": false,
    "derivation": "true_false_each",
    "basis": "direct",
    "derived_from": {
