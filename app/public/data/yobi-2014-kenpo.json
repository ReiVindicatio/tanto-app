ction":"pdftotext"},"flags":[]}],"statements":[{"id":"yobi-2014-kenpo-q01-a","question_id":"yobi-2014-kenpo-q01","label":"ア","text":"外国人の場合には，我が国との関係が日本国民とは異なるので，日本国民に比べて裁判を受ける権利の保障の程度に差を設けることも許される。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":1,"official_answer":7}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[17,18]},"same_as":[{"id":"shiho-2014-kenpo-q02-a","exam":"司法","era":"H26","year":2014,"number":2,"label":"ア"}]},{"id":"yobi-2014-kenpo-q01-b","question_id":"yobi-2014-kenpo-q01","label":"イ","text":"法人は，現代社会におけるその役割の重要性からすると，全ての人権について，自然人と同程度の保障を受ける。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":1,"official_answer":7}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[19,20]},"same_as":[{"id":"shiho-2014-kenpo-q02-b","exam":"司法","era":"H26","year":2014,"number":2,"label":"イ"}]},{"id":"yobi-2014-kenpo-q01-c","question_id":"yobi-2014-kenpo-q01","label":"ウ","text":"未成年者は，精神的・肉体的に未成熟なことから，成人とは異なった特別の保護を必要とする場合があり，このような趣旨から，憲法は児童の酷使を禁止している。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":1,"official_answer":7}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[21,22]},"same_as":[{"id":"shiho-2014-kenpo-q02-c","exam":"司法","era":"H26","year":2014,"number":2,"label":"ウ"}]},{"id":"yobi-2014-kenpo-q02-a","question_id":"yobi-2014-kenpo-q02","label":"ア","text":"日本国籍は重要な法的地位であり，父母の婚姻による嫡出子たる身分の取得は子が自らの意思や努力によっては変えられない事柄であることから，こうした事柄により国籍取得に関して区別することに合理的な理由があるか否かについては，慎重な検討が必要である。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":2,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[33,35]},"same_as":[{"id":"shiho-2014-kenpo-q03-a","exam":"司法","era":"H26","year":2014,"number":3,"label":"ア"}]},{"id":"yobi-2014-kenpo-q02-b","question_id":"yobi-2014-kenpo-q02","label":"イ","text":"非嫡出子という身分は子が自らの意思や努力によって変えることはできないから，嫡出性の有無による法定相続分の区別の合理性については，立法目的自体の合理性及び当該目的と手段との実質的関連性についてより強い合理性の存否を検討すべきである。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":3,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[36,38]},"same_as":[{"id":"shiho-2014-kenpo-q03-b","exam":"司法","era":"H26","year":2014,"number":3,"label":"イ"}]},{"id":"yobi-2014-kenpo-q02-c","question_id":"yobi-2014-kenpo-q02","label":"ウ","text":"尊属殺という特別の罪を設け，刑罰を加重すること自体は直ちに違憲とはならないが，加重の程度が極端であって，立法目的達成の手段として甚だしく均衡を失し，これを正当化し得べき根拠を見出し得ないときは，その差別は著しく不合理なものとして違憲となる。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":4,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[39,41]},"same_as":[{"id":"shiho-2014-kenpo-q03-c","exam":"司法","era":"H26","year":2014,"number":3,"label":"ウ"}]},{"id":"yobi-2014-kenpo-q03-a","question_id":"yobi-2014-kenpo-q03","label":"ア","text":"生徒が自らの信仰に基づき，その通学する公立校で義務付けられている授業の履修を拒んだため不利益処分を受けることになっても，公教育が特例なしに実施されるべきであることに鑑み，その不利益の内容や程度に関わりなく，これを受忍しなければならない。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":5,"official_answer":7}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[54,56]},"same_as":[{"id":"shiho-2014-kenpo-q05-a","exam":"司法","era":"H26","year":2014,"number":5,"label":"ア"}]},{"id":"yobi-2014-kenpo-q03-b","question_id":"yobi-2014-kenpo-q03","label":"イ","text":"僧侶がその業務として遂行した行為の結果，刑法上の犯罪構成要件に該当することになった場合，その行為の目的や内容に宗教上の意義が認められるときは，たとえそれが著しく社会的妥当性を欠くものであっても，正当な業務行為として処罰の対象とはならない。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":5,"official_answer":7}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[57,59]},"same_as":[{"id":"shiho-2014-kenpo-q05-b","exam":"司法","era":"H26","year":2014,"number":5,"label":"イ"}]},{"id":"yobi-2014-kenpo-q03-c","question_id":"yobi-2014-kenpo-q03","label":"ウ","text":"宗教法人が法令に違反して著しく反社会的な行為を組織的に行ったため，裁判所から宗教法人法所定の解散命令を受け，法人格を失った宗教団体やその信者が宗教上の行為を継続する上で支障が生じても，その支障は間接的で事実上のものにとどまるので，やむを得ない。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":5,"official_answer":7}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[60,62]},"same_as":[{"id":"shiho-2014-kenpo-q05-c","exam":"司法","era":"H26","year":2014,"number":5,"label":"ウ"}]},{"id":"yobi-2014-kenpo-q04-a","question_id":"yobi-2014-kenpo-q04","label":"ア","text":"ａ．名誉毀損のおそれのある記事を掲載した書籍の販売等を，裁判所の仮処分により事前差止めするのは，「検閲」に該当しない。ｂ．「検閲」の解釈に当たっては，過去に検閲が行政権により濫用されたという歴史的経緯を踏まえる必要がある。","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[72,75]}},{"id":"yobi-2014-kenpo-q04-b","question_id":"yobi-2014-kenpo-q04","label":"イ","text":"ａ．外国で出版済みの書籍について，輸入禁制品である「公安又は風俗を害すべき書籍」に該当するか否かを税関が検査するのは，「検閲」に該当しない。ｂ．「検閲」は，表現の自由に対する制約という側面と，この自由と一体をなす知る権利に対する制約という側面がある。","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[76,79]}},{"id":"yobi-2014-kenpo-q04-c","question_id":"yobi-2014-kenpo-q04","label":"ウ","text":"ａ．受刑者の逃走防止等を目的として，その発信しようとする信書の内容を刑務所長が事前に検査するのは，「検閲」に該当しない。ｂ．「検閲」の禁止は，国民に対する関係では，絶対的に禁止されるが，特殊の法律関係にある者については，異なる取扱いが認められる。","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[80,83]}},{"id":"yobi-2014-kenpo-q05-a","question_id":"yobi-2014-kenpo-q05","label":"ア","text":"教授の自由の保障は，その沿革上，高等教育の場である大学に限られ，普通教育の場における教師の教授の自由は，学問の自由やその他の憲法上の自由として保障されているわけではない。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":9,"official_answer":7}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[97,99]},"same_as":[{"id":"shiho-2014-kenpo-q08-a","exam":"司法","era":"H26","year":2014,"number":8,"label":"ア"}]},{"id":"yobi-2014-kenpo-q05-b","question_id":"yobi-2014-kenpo-q05","label":"イ","text":"大学は，自治権を有し，その施設及び学生の管理に関して自主的に決定する権利を有することから，警察は，大学の了解なしには大学構内において令状に基づく犯罪捜査を行うことはできない。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":9,"official_answer":7}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[100,102]},"same_as":[{"id":"shiho-2014-kenpo-q08-b","exam":"司法","era":"H26","year":2014,"number":8,"label":"イ"}]},{"id":"yobi-2014-kenpo-q05-c","question_id":"yobi-2014-kenpo-q05","label":"ウ","text":"大学教授が授業中に行ったその所属学部の執行部への批判を理由として，当該学部が当該教授の授業開講を認めない措置を採るような場合には，学問の自由と大学の自治とが対立的な関係に立つ。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":9,"official_answer":7}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[103,105]},"same_as":[{"id":"shiho-2014-kenpo-q08-c","exam":"司法","era":"H26","year":2014,"number":8,"label":"ウ"}]},{"id":"yobi-2014-kenpo-q06-a","question_id":"yobi-2014-kenpo-q06","label":"ア","text":"限られた財源の下で福祉的給付を行うに当たり，国が自国民を在留外国人より優先的に扱うことは許されるが，特別永住者について障害福祉年金の支給対象から一切除外することは，不合理な差別となる。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":10,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[115,117]},"same_as":[{"id":"shiho-2014-kenpo-q10-a","exam":"司法","era":"H26","year":2014,"number":10,"label":"ア"}]},{"id":"yobi-2014-kenpo-q06-b","question_id":"yobi-2014-kenpo-q06","label":"イ","text":"障害基礎年金の受給に関し，保険料の拠出要件を緩和するか否かは国の財政事情等に密接に関連するから，保険料負担能力のない２０歳以上６０歳未満の者のうち学生とそれ以外の者との間に障害基礎年金の受給に関し差異が生じていたとしても，不合理とはいえない。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":11,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[118,120]},"same_as":[{"id":"shiho-2014-kenpo-q10-b","exam":"司法","era":"H26","year":2014,"number":10,"label":"イ"}]},{"id":"yobi-2014-kenpo-q06-c","question_id":"yobi-2014-kenpo-q06","label":"ウ","text":"生活保護法に基づいて生活保護を受けるのは，単なる国の恩恵ないし社会政策の実施に伴う反射的利益ではなく，法的権利であるから，保護基準の改定（老齢加算の廃止）に基づく保護の不利益変更は，その改定自体に正当な理由がない限り違法となる。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":12,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[121,123]},"same_as":[{"id":"shiho-2014-kenpo-q10-c","exam":"司法","era":"H26","year":2014,"number":10,"label":"ウ"}]},{"id":"yobi-2014-kenpo-q07-a","question_id":"yobi-2014-kenpo-q07","label":"ア","text":"国家公務員は，その地位の特殊性や職務の公共性に加え，勤労条件が法律・予算により定められており，人事院をはじめとする代償措置が講じられていることなどからすれば，その争議行為を全面的に禁止することは，やむを得ない制約である。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":13,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[132,134]}},{"id":"yobi-2014-kenpo-q07-b","question_id":"yobi-2014-kenpo-q07","label":"イ","text":"人事院勧告の実施が凍結され，労働基本権の制約の代償措置がその本来の機能を果たさず実際上画餅に等しいとみられる事態が生じた場合には，国家公務員がその正常な運用を要求して相当な手段態様で争議行為を行うことは，憲法上保障される。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":14,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[135,137]}},{"id":"yobi-2014-kenpo-q07-c","question_id":"yobi-2014-kenpo-q07","label":"ウ","text":"非権力的な労務に従事する現業の国家公務員は憲法第２８条の勤労者にほかならず，労働基本権の保障を受けるから，全体の奉仕者であることを理由として，非現業の国家公務員と同様に争議行為を全面的に禁止することは，合理的な理由を欠く。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":15,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[138,140]}},{"id":"yobi-2014-kenpo-q08-a","question_id":"yobi-2014-kenpo-q08","label":"ア","text":"およそ国際紛争解決の手段でない戦争というものは現実にはあり得ず，侵略戦争と自衛戦争等を峻別することは困難である。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":16,"official_answer":6}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[153,154]}},{"id":"yobi-2014-kenpo-q08-b","question_id":"yobi-2014-kenpo-q08","label":"イ","text":"非武装平和主義を掲げた憲法の特徴は第９条第２項にあり，同項は，単なる確認的規定ではなく，実質的な意義を有する規定と解するべきである。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":16,"official_answer":6}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[155,156]}},{"id":"yobi-2014-kenpo-q08-c","question_id":"yobi-2014-kenpo-q08","label":"ウ","text":"国際法上，交戦権とは，敵国領土の占領，船舶の臨検・拿捕，あるいは敵国兵力の破壊を行う権利など，交戦国に認められている諸権利のことをいう。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":16,"official_answer":6}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[157,158]}},{"id":"yobi-2014-kenpo-q09-a","question_id":"yobi-2014-kenpo-q09","label":"ア","text":"公職選挙法は，投票を得るなどの目的で戸別訪問をすること自体を禁止しているが，選挙運動の重要性に照らすと，その禁止の範囲は憲法に適合するよう限定して解釈しなければならない。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":17,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[169,171]},"same_as":[{"id":"shiho-2014-kenpo-q13-a","exam":"司法","era":"H26","year":2014,"number":13,"label":"ア"}]},{"id":"yobi-2014-kenpo-q09-b","question_id":"yobi-2014-kenpo-q09","label":"イ","text":"いわゆる立候補の自由は，選挙権の自由な行使と表裏の関係にあり，自由かつ公正な選挙を維持する上で極めて重要であるとして，憲法第１５条第１項によって保障されていると解すべきである。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":18,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[172,174]},"same_as":[{"id":"shiho-2014-kenpo-q13-b","exam":"司法","era":"H26","year":2014,"number":13,"label":"イ"}]},{"id":"yobi-2014-kenpo-q09-c","question_id":"yobi-2014-kenpo-q09","label":"ウ","text":"選挙や当選の効力に関する争訟において，誰が誰に対して投票したかを解明し，これを公表することは，選挙投票の全般にわたってその秘密を確保しようとする無記名投票制度の精神に反する。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":19,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[175,177]},"same_as":[{"id":"shiho-2014-kenpo-q13-c","exam":"司法","era":"H26","year":2014,"number":13,"label":"ウ"}]},{"id":"yobi-2014-kenpo-q10-a","question_id":"yobi-2014-kenpo-q10","label":"ア","text":"不逮捕特権を定める目的が議院の審議権の確保にあるとする見解に立つと，国会議員に対する逮捕請求の理由が正当であっても，議院は，議員の逮捕を許諾しないことができる。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":20,"official_answer":3}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[184,185]}},{"id":"yobi-2014-kenpo-q10-b","question_id":"yobi-2014-kenpo-q10","label":"イ","text":"免責特権を定める目的が議員の職務執行の自由の保障にあるとする見解に立つと，地方公聴会における行為まで免責の対象とならない。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":20,"official_answer":3}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[186,187]}},{"id":"yobi-2014-kenpo-q10-c","question_id":"yobi-2014-kenpo-q10","label":"ウ","text":"免責特権の趣旨は，議院内で行った発言を理由に院外で法的責任を問われないというものであり，その発言を理由に所属政党から除名されることはある。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":20,"official_answer":3}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[188,189]}},{"id":"yobi-2014-kenpo-q11-a","question_id":"yobi-2014-kenpo-q11","label":"ア","text":"日米安全保障条約は，主権国としての我が国の存立の基礎に極めて重大な関係を持つ高度の政治性を有するもので，その内容の合憲性判断は，一見極めて明白に違憲無効でない限り，裁判所の審査権の範囲外である。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":21,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[204,206]}},{"id":"yobi-2014-kenpo-q11-b","question_id":"yobi-2014-kenpo-q11","label":"イ","text":"日米安全保障条約及び日米地位協定が違憲無効であることが一見極めて明白でない以上，裁判所としては，これらが合憲であることを前提として，これらの条約を履行するために制定された，いわゆる駐留軍用地特措法の合憲性を審査すべきである。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":21,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[207,209]}},{"id":"yobi-2014-kenpo-q11-c","question_id":"yobi-2014-kenpo-q11","label":"ウ","text":"衆議院解散の効力をめぐる争いは，本来，内閣と衆議院という両政治部門間の争いであり，議員歳費請求のように前提問題として解散の効力を争う場合であっても，その実質は機関訴訟というべきもので，裁判所は，原則として統治部門の自律的解決を尊重すべきである。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":21,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[210,212]}},{"id":"yobi-2014-kenpo-q12-a","question_id":"yobi-2014-kenpo-q12","label":"ア","text":"租税の賦課は法律又は法律の定める条件によらなければならないが，条例は公選の議員で組織する議会の議決を経て制定される自治立法であるから，一定の範囲内で条例による租税の賦課徴収ができる。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":22,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[224,226]},"same_as":[{"id":"shiho-2014-kenpo-q18-a","exam":"司法","era":"H26","year":2014,"number":18,"label":"ア"}]},{"id":"yobi-2014-kenpo-q12-b","question_id":"yobi-2014-kenpo-q12","label":"イ","text":"課税の根拠法律があるにもかかわらず長年にわたり課税されなかった物については，非課税の慣習法が成立しているとみるべきであるから，新たにその物に課税することは，それがその根拠法律の正しい解釈に基づくものであるとしても，租税法律主義に反する。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":23,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[227,229]},"same_as":[{"id":"shiho-2014-kenpo-q18-b","exam":"司法","era":"H26","year":2014,"number":18,"label":"イ"}]},{"id":"yobi-2014-kenpo-q12-c","question_id":"yobi-2014-kenpo-q12","label":"ウ","text":"租税法律主義は，社会全体に対する財やサービスを提供するための資金を租税として強制的に徴収する場合について規定したものであるから，個人への給付に対する反対給付としての性質を有する保険料等については適用がなく，また，その趣旨も及ばない。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":24,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[230,232]},"same_as":[{"id":"shiho-2014-kenpo-q18-c","exam":"司法","era":"H26","year":2014,"number":18,"label":"ウ"}]}],"explanations":[{"id":"exp-yobi-2014-kenpo-q01-a","statement_id":"yobi-2014-kenpo-q01-a","version":1,"conclusion":"×。裁判を受ける権利は32条が「何人も」と定める権利であり、その性質上外国人にも日本国民と同様に保障されると解されているので、保障の程度に差を設けることは許されない。","body":"ポイントは、裁判を受ける権利が外国人について日本国民と差を設けてよい性質の権利かである。32条は「何人も、裁判所において裁判を受ける権利を奪はれない。」と定め、権利の主体を国民に限っていない。外国人の人権については、権利の性質上日本国民のみを対象としているものを除き外国人にも保障が及ぶと解されており、裁判を受ける権利は、権利を救済するための基本的な手段であって、国籍によって保障の程度を変える理由のない権利と理解されている。参政権や社会権のように国家との関係から外国人への保障に差が出ると解されている権利とは異なる。したがって、裁判を受ける権利の保障の程度に差を設けることも許されるとする本肢は誤りである。","citations":[{"type":"statute","law":"日本国憲法","article":"32","paragraphs":["1"],"quote":"何人も、裁判所において裁判を受ける権利を奪はれない。","text_sha256":"27e481f6fd8314b520fa5fdbbd506f16532a7e60a909551b71117b6de92dbb10","fetched_at":"2026-10-18","source_url":"https://laws.e-gov.go.jp/api/1/lawdata/%E6%98%AD%E5%92%8C%E4%BA%8C%E5%8D%81%E4%B8%80%E5%B9%B4%E6%86%B2%E6%B3%95"}],"cases":[],"prompt_version":"explain-v2","generated_at":"2026-10-21","model":"claude-opus-5-5"},{"id":"exp-yobi-2014-kenpo-q01-b","statement_id":"yobi-2014-kenpo-q01-b","version":1,"conclusion":"×。法人にも人権規定は性質上可能な限り適用されると解されているが、自然人だけを前提とする権利もあり、「全ての人権について，自然人と同程度の保障」を受けるわけではない。","body":"ポイントは、「全ての人権について，自然人と同程度」という部分である。法人も社会において重要な活動をする実体であることから、憲法の人権規定は性質上可能な限り法人にも適用されると解されている（判例あり（要確認））。もっとも、選挙権、生存権、人身の自由のように自然人であることを前提とする権利は、その性質上法人には保障されないと解されている。また、法人に保障される権利でも、その社会的・経済的な影響力の大きさから、自然人とは異なる制約を受けることがありうると説明されている。したがって、全ての人権について自然人と同程度の保障を受けるとする本肢は誤りである。","citations":[],"cases":[],"prompt_version":"explain-v2","generated_at":"2026-10-21","model":"claude-opus-5-5"},{"id":"exp-yobi-2014-kenpo-q01-c","statement_id":"yobi-2014-kenpo-q01-c","version":1,"conclusion":"○。27条3項は「児童は、これを酷使してはならない。」と定めており、未成年者の未成熟さに着目した特別の保護の規定といえる。","body":"ポイントは、憲法に児童の酷使を禁止する規定があるかである。27条3項は「児童は、これを酷使してはならない。」と定めている。未成年者は精神的・肉体的に未成熟であるため、成人と同じ扱いでは十分に保護されない場合があり、成人とは異なる特別の保護が必要になることがあると解されている。児童の酷使の禁止は、こうした趣旨から勤労の場面で児童を保護するものと理解されている。したがって本肢は正しい。","citations":[{"type":"statute","law":"日本国憲法","article":"27","paragraphs":["3"],"quote":"児童は、これを酷使してはならない。","text_sha256":"923747bd5336da87aa648187395efb9c50dd209c471f69ba3f9550382820c1e3","fetched_at":"2026-10-18","source_url":"https://laws.e-gov.go.jp/api/1/lawdata/%E6%98%AD%E5%92%8C%E4%BA%8C%E5%8D%81%E4%B8%80%E5%B9%B4%E6%86%B2%E6%B3%95"}],"cases":[],"prompt_version":"explain-v2","generated_at":"2026-10-21","model":"claude-opus-5-5"},{"id":"exp-yobi-2014-kenpo-q02-a","statement_id":"yobi-2014-kenpo-q02-a","version":1,"conclusion":"○。国籍法違憲判決は、日本国籍が重要な法的地位であり、準正による嫡出子の身分取得は子が自らの意思や努力で変えられない事柄であるから、これによる区別の合理性は慎重に検討する必要があるとした。","body":"ポイントは、国籍取得の区別についての審査の姿勢である。14条1項は「すべて国民は、法の下に平等であつて、人種、信条、性別、社会的身分又は門地により、政治的、経済的又は社会的関係において、差別されない。」と定める。最高裁判所大法廷は、当時の国籍法の規定が父母の婚姻による嫡出子の身分の取得（準正）を届出による国籍取得の要件としていたことについて、日本国籍は基本的人権の保障や公的資格の付与等を受ける上で意味を持つ重要な法的地位であり、嫡出子の身分を取得するか否かは子にとって自らの意思や努力によっては変えられない父母の身分行為に係る事柄であるから、これにより区別を生じさせることに合理的な理由があるか否かは慎重に検討することが必要であるとした。そのうえで、この区別は遅くとも上告人らが届出をした当時には14条1項に違反していたと判断した。本肢はこの判示の趣旨と一致するので、正しい。","citations":[{"type":"statute","law":"日本国憲法","article":"14","paragraphs":["1"],"quote":"すべて国民は、法の下に平等であつて、人種、信条、性別、社会的身分又は門地により、政治的、経済的又は社会的関係において、差別されない。","text_sha256":"5a3ca47aaefdabad6cbfacc1dba63dd3c9937d55178831ecf8c7b0d2f30b2eb4","fetched_at":"2026-10-18","source_url":"https://laws.e-gov.go.jp/api/1/lawdata/%E6%98%AD%E5%92%8C%E4%BA%8C%E5%8D%81%E4%B8%80%E5%B9%B4%E6%86%B2%E6%B3%95"}],"cases":[{"name":"国籍法違憲判決（国籍確認請求事件）","court":"最高裁判所大法廷","date":"2008-06-04","holding":"日本国籍は重要な法的地位であり、準正による嫡出子の身分の取得は子が自らの意思や努力で変えられない事柄であるから、これによる国籍取得の区別の合理性は慎重に検討する必要があるとし、国籍法3条1項の準正要件による区別は遅くとも平成17年当時には憲法14条1項に違反していたとした。"}],"prompt_version":"explain-v2","generated_at":"2026-10-21","model":"claude-opus-5-5"},{"id":"exp-yobi-2014-kenpo-q02-b","statement_id":"yobi-2014-kenpo-q02-b","version":1,"conclusion":"×。最高裁判所は、法定相続分の区別について、立法府の裁量権を考慮しても合理的な根拠が認められないかという基準で判断しており、「実質的関連性」を問うより厳格な基準は採っていない。","body":"ポイントは、判例が採った審査の基準である。平成25年の大法廷決定は、相続制度をどう定めるかは立法府の合理的な裁量判断に委ねられているとしたうえで、立法府に与えられた裁量権を考慮しても、嫡出子と嫡出でない子との区別をすることに合理的な根拠が認められない場合に14条1項に違反するという基準を示した。同決定は、平成7年の大法廷決定（最高裁平成3年（ク）第143号同7年7月5日決定）も同旨の判断基準の下で、この規定を立法府に与えられた合理的な裁量判断の限界を超えたものとはいえないとして合憲と判断したものと整理している。本肢のように、身分を子が変えられないことを理由に、立法目的と手段との「実質的関連性」まで問うより強い合理性の審査を求める考え方は、判例の多数意見のものではない。したがって本肢は誤りである。","citations":[{"type":"statute","law":"日本国憲法","article":"14","paragraphs":["1"],"quote":"すべて国民は、法の下に平等であつて","text_sha256":"5a3ca47aaefdabad6cbfacc1dba63dd3c9937d55178831ecf8c7b0d2f30b2eb4","fetched_at":"2026-10-18","source_url":"https://laws.e-gov.go.jp/api/1/lawdata/%E6%98%AD%E5%92%8C%E4%BA%8C%E5%8D%81%E4%B8%80%E5%B9%B4%E6%86%B2%E6%B3%95"}],"cases":[{"name":"非嫡出子相続分違憲決定（遺産分割審判に対する抗告棄却決定に対する特別抗告事件）","court":"最高裁判所大法廷","date":"2013-09-04","holding":"相続制度の定めは立法府の合理的な裁量判断に委ねられており、その裁量権を考慮しても区別に合理的な根拠が認められない場合に憲法14条1項違反になるという基準の下で、嫡出でない子の相続分を嫡出子の2分の1とする民法900条4号ただし書前段は、遅くとも平成13年7月当時において憲法14条1項に違反していたとした。"}],"prompt_version":"explain-v2","generated_at":"2026-10-21","model":"claude-opus-5-5"},{"id":"exp-yobi-2014-kenpo-q02-c","statement_id":"yobi-2014-kenpo-q02-c","version":1,"conclusion":"○。尊属殺重罰規定違憲判決は、尊属殺の加重規定を設けること自体は直ちに違憲ではないが、加重の程度が極端で立法目的達成の手段として甚だしく均衡を失するときは違憲になるとしたと解されている。","body":"ポイントは、尊属殺の加重を違憲とした理由が、加重すること自体か、加重の程度かである。14条1項は「すべて国民は、法の下に平等であつて、人種、信条、性別、社会的身分又は門地により、政治的、経済的又は社会的関係において、差別されない。」と定める。最高裁判所大法廷の判決（昭和45年（あ）第1310号同48年4月4日判決）は、尊属に対する尊重報恩という立法目的に基づいて尊属殺を重く処罰すること自体は直ちに不合理な差別とはいえないが、当時の刑法の尊属殺の規定の法定刑が死刑又は無期懲役に限られていて加重の程度が極端であり、立法目的達成の手段として甚だしく均衡を失するので14条1項に違反するとしたと理解されている（判例あり（要確認））。本肢はこの理解と一致するので、正しい。","citations":[{"type":"statute","law":"日本国憲法","article":"14","paragraphs":["1"],"quote":"すべて国民は、法の下に平等であつて、人種、信条、性別、社会的身分又は門地により、政治的、経済的又は社会的関係において、差別されない。","text_sha256":"5a3ca47aaefdabad6cbfacc1dba63dd3c9937d55178831ecf8c7b0d2f30b2eb4","fetched_at":"2026-10-18","source_url":"https://laws.e-gov.go.jp/api/1/lawdata/%E6%98%AD%E5%92%8C%E4%BA%8C%E5%8D%81%E4%B8%80%E5%B9%B4%E6%86%B2%E6%B3%95"}],"cases":[],"prompt_version":"explain-v2","generated_at":"2026-10-21","model":"claude-opus-5-5"}]}