[]},"statements":["yobi-2012-kenpo-q11-a","yobi-2012-kenpo-q11-b","yobi-2012-kenpo-q11-c"],"statement_truth_derivable":true,"provenance":{"question_pdf":"data/raw/予備試験/短答/H24-2012/憲法行政法_問題.pdf","answer_pdf":"data/raw/予備試験/短答/H24-2012/憲法行政法_正答.pdf","page":5,"line_range":[181,197],"extraction":"pdftotext"},"flags":[]},{"id":"yobi-2012-kenpo-q12","exam":{"type":"yobi","year":2012,"era":"H24"},"subject":"kenpo","number":12,"points":2,"format":"meta_choice","polarity":null,"exhaustive":false,"unordered":false,"stem":"憲法改正について，その限界を理論的に想定する見解（限界説）と限界は理論的には存在しないとする見解（無限界説）とが対立しているが，次の各記述について，限界説の立場に立つ記述を全て挙げたものを，後記１から７までの中から選びなさい。（解答欄は，［№24］）","context":[],"sub_questions":[],"requires_context":false,"choices":[{"number":1,"text":"アイウ"},{"number":2,"text":"アイ"},{"number":3,"text":"アウ"},{"number":4,"text":"イウ"},{"number":5,"text":"ア"},{"number":6,"text":"イ"},{"number":7,"text":"ウ"}],"answer_slots":[{"no":24,"official_answer":2}],"scoring":{"partial_credit":null,"no_partial_credit":false,"raw_note":""},"status":{"voided":false,"all_correct":false,"errata":[]},"statements":["yobi-2012-kenpo-q12-a","yobi-2012-kenpo-q12-b","yobi-2012-kenpo-q12-c"],"statement_truth_derivable":false,"provenance":{"question_pdf":"data/raw/予備試験/短答/H24-2012/憲法行政法_問題.pdf","answer_pdf":"data/raw/予備試験/短答/H24-2012/憲法行政法_正答.pdf","page":6,"line_range":[199,213],"extraction":"pdftotext"},"flags":[]}],"statements":[{"id":"yobi-2012-kenpo-q01-a","question_id":"yobi-2012-kenpo-q01","label":"ア","text":"人種とは，身体的特徴によって区別される人類学上の種類であり，国によって人々の身体的特徴は異なるので，憲法上，国籍差別も人種差別と同様に扱われる。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"combination","basis":"selected","derived_from":{"slots":[{"no":1,"official_answer":3}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[14,15]}},{"id":"yobi-2012-kenpo-q01-b","question_id":"yobi-2012-kenpo-q01","label":"イ","text":"信条とは，言葉の由来から宗教上の信念を意味するが，今日では広く世俗的な政治上の主義や思想的な主張も含むと解されている。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"combination","basis":"uniqueness","derived_from":{"slots":[{"no":1,"official_answer":3}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[16,17]}},{"id":"yobi-2012-kenpo-q01-c","question_id":"yobi-2012-kenpo-q01","label":"ウ","text":"社会的身分の意味については狭義説，中間説，広義説と見解が分かれるが，最高裁判所は広義説を採用している。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"combination","basis":"uniqueness","derived_from":{"slots":[{"no":1,"official_answer":3}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[18,19]}},{"id":"yobi-2012-kenpo-q01-d","question_id":"yobi-2012-kenpo-q01","label":"エ","text":"性別とは男女の別をいうが，歴史的に差別されてきたのは女性であるから，憲法上は男性差別を問題にする必要はない。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"combination","basis":"selected","derived_from":{"slots":[{"no":1,"official_answer":3}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[20,21]}},{"id":"yobi-2012-kenpo-q02-a","question_id":"yobi-2012-kenpo-q02","label":"ア","text":"両決定は，いずれも，差止めの実質的要件について，北方ジャーナル事件判決（最大判昭和６１年６月１１日）を参照し，公共性，公益性，重大にして著しく回復困難な損害を被るおそれ，という３要件を用いた。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":2,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[31,33]}},{"id":"yobi-2012-kenpo-q02-b","question_id":"yobi-2012-kenpo-q02","label":"イ","text":"両決定は，記事内容の公共性について判断を異にした。抗告審は，婚姻や離婚という出来事自体は私事であるが，娘は政治家一家の長女であって後継者となる可能性があることを理由に，記事内容の公共性を認めた。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":3,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[34,36]}},{"id":"yobi-2012-kenpo-q02-c","question_id":"yobi-2012-kenpo-q02","label":"ウ","text":"両決定は，損害の程度の評価をめぐって判断を異にした。抗告審は，本件記事で取り上げられた私事自体は人格に対する評価に常につながるものではないし，日常的にどうということなく見聞する情報の一つにすぎない，と判断した。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":4,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[37,39]}},{"id":"yobi-2012-kenpo-q03-a","question_id":"yobi-2012-kenpo-q03","label":"ア","text":"職業活動の自由についても精神的自由についても，国の積極的な社会経済政策のために規制することが許されるのは同様であるが，前者の自由を規制する場合には立法府の裁量的判断が広く認められる点が異なる。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":5,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[46,48]}},{"id":"yobi-2012-kenpo-q03-b","question_id":"yobi-2012-kenpo-q03","label":"イ","text":"憲法第２２条第１項が「公共の福祉に反しない限り」という留保を伴っているのは，職業活動は社会的相互関連性が大きく，精神的自由と比較して公権力による規制の要請が強いことを強調するためである。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":6,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[49,51]}},{"id":"yobi-2012-kenpo-q03-c","question_id":"yobi-2012-kenpo-q03","label":"ウ","text":"職業の許可制は自由に対する強力な制限であるから，その合憲性を肯定し得るためには，原則として重要な公共の利益のために必要かつ合理的な措置であることを要する。ただし，この要請は，個々の許可条件の合憲性判断においてまで求められるものではない。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":7,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[52,54]}},{"id":"yobi-2012-kenpo-q04-a","question_id":"yobi-2012-kenpo-q04","label":"ア","text":"憲法第２９条は，私有財産制度を保障しているのみでなく，国民の個々の財産権につきこれを基本的人権として保障しているが，それ自体に内在する制約があるほか，社会全体の利益を図るための規制により制約を受ける。","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[64,66]}},{"id":"yobi-2012-kenpo-q04-b","question_id":"yobi-2012-kenpo-q04","label":"イ","text":"財産権規制の目的には，社会政策及び経済政策上の積極的なものから，安全の保障や秩序の維持等の消極的なものまで種々様々なものがあり得るが，森林法の共有林分割請求権を制限する規定は積極目的による規制である。","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[67,69]}},{"id":"yobi-2012-kenpo-q04-c","question_id":"yobi-2012-kenpo-q04","label":"ウ","text":"財産権規制の目的が公共の福祉に合致しないことが明らかであるか，規制手段が規制目的を達成する手段として必要性や合理性に欠けていることが明らかであって，立法府の判断が合理的裁量の範囲を超えるものとなる場合に限り，当該規制立法は違憲となる。","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[70,72]}},{"id":"yobi-2012-kenpo-q05-a","question_id":"yobi-2012-kenpo-q05","label":"ア","text":"憲法第１７条は，公務員の不法行為による国又は公共団体の損害賠償責任を免除又は制限する法律が立法権の裁量を逸脱したものである場合には，これを違憲無効とする効力を持つ規定である。","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[85,87]}},{"id":"yobi-2012-kenpo-q05-b","question_id":"yobi-2012-kenpo-q05","label":"イ","text":"書留郵便物について，郵便業務従事者の故意又は重大な過失によって損害が生じた場合に，国の損害賠償責任を全面的に免除する立法は違憲無効であるが，法律で国が負担すべき賠償額に一定の制限を付することは許される。","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[88,90]}},{"id":"yobi-2012-kenpo-q05-c","question_id":"yobi-2012-kenpo-q05","label":"ウ","text":"特別送達郵便物について，郵便業務従事者の故意又は重大な過失によって損害が生じた場合に，国の損害賠償責任を免除又は制限する立法は違憲無効であるが，軽過失にとどまる場合には，国の損害賠償責任を免除又は制限することも許される。","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[91,93]}},{"id":"yobi-2012-kenpo-q06-a","question_id":"yobi-2012-kenpo-q06","label":"ア","text":"憲法第２６条第２項前段は，国民がその保護する子女に普通教育を受けさせる義務を負うことを定めている。これは，同条第１項が保障する子どもの教育を受ける権利の保障に対応したものであって，子ども自身に教育を受ける義務を負わせるものではない。","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[105,107]}},{"id":"yobi-2012-kenpo-q06-b","question_id":"yobi-2012-kenpo-q06","label":"イ","text":"憲法第２７条第１項は，国民の勤労の義務を定めている。したがって，憲法第１８条で禁止されている「その意に反する苦役」に至らないものであれば，法律の定めにより，刑罰をもって勤労を強制することも許される。","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[108,110]}},{"id":"yobi-2012-kenpo-q06-c","question_id":"yobi-2012-kenpo-q06","label":"ウ","text":"憲法第３０条は，国民の納税義務を定めている。この規定は，国家の存立に不可欠な財政を支えるという国民としての当然の義務を確認するとともに，その義務の具体化には法律の定めが必要であるとしたものである。","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[111,113]}},{"id":"yobi-2012-kenpo-q07-a","question_id":"yobi-2012-kenpo-q07","label":"ア","text":"天皇は，精神若しくは身体の疾患又は事故があるときは，国事行為を委任することができる。この場合には，摂政が天皇の名で国事行為を行う。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"combination","basis":"uniqueness","derived_from":{"slots":[{"no":11,"official_answer":4}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[122,123]}},{"id":"yobi-2012-kenpo-q07-b","question_id":"yobi-2012-kenpo-q07","label":"イ","text":"皇室に財産を譲り渡し，又は皇室が財産を譲り受け，若しくは賜与することは国会の議決に基づかなければならない，というのが憲法の定める原則である。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"combination","basis":"selected","derived_from":{"slots":[{"no":11,"official_answer":4}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[124,125]}},{"id":"yobi-2012-kenpo-q07-c","question_id":"yobi-2012-kenpo-q07","label":"ウ","text":"皇位の継承について，大日本帝国憲法は，「皇男子孫之ヲ継承ス」と定めていたが，日本国憲法は，男系男子主義までも求めるものではない。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"combination","basis":"selected","derived_from":{"slots":[{"no":11,"official_answer":4}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[126,127]}},{"id":"yobi-2012-kenpo-q07-d","question_id":"yobi-2012-kenpo-q07","label":"エ","text":"国務大臣の任免，法律の定めるその他の官吏の任免の認証は，天皇の国事行為とされている。認証は，これらの行為の効力要件である。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"combination","basis":"uniqueness","derived_from":{"slots":[{"no":11,"official_answer":4}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[128,129]}},{"id":"yobi-2012-kenpo-q08-a","question_id":"yobi-2012-kenpo-q08","label":"ア","text":"選挙運動の規律は，選挙制度の仕組みの一部をなすものとして，国会が裁量により定めることができる。衆議院の小選挙区選挙において，候補者以外に候補者届出政党にも独自の選挙運動が認められているのは，選挙制度を政策本位，政党本位にするという正当な政策的目的によるものといえる。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":12,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[138,141]}},{"id":"yobi-2012-kenpo-q08-b","question_id":"yobi-2012-kenpo-q08","label":"イ","text":"政党は議会制民主主義を支える重要な存在であり，政党間の批判や論評は公共性の極めて強い事項である。したがって，ある政党が新聞紙上の広告で他の政党を批判した場合，それが名誉毀損に当たらない場合であっても，批判された政党は同じ新聞紙上に反論文を掲載する権利を有する。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":13,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[142,145]}},{"id":"yobi-2012-kenpo-q08-c","question_id":"yobi-2012-kenpo-q08","label":"ウ","text":"憲法は，議会制民主主義を支える不可欠の要素として，政党の存在を当然に予定している。したがって，個人だけでなく，営利法人たる株式会社や特定職業に従事する者についての強制加入団体も，社会的実在として期待される当然の行為として，政党などの政治団体に対して政治資金の寄附を行う権利能力を有する。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":14,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[146,149]}},{"id":"yobi-2012-kenpo-q09-a","question_id":"yobi-2012-kenpo-q09","label":"ア","text":"衆議院と参議院を比較すると，衆議院の方が議員の任期が短く，また解散により必要な場合には民意を問える地位にある点で，相対的に見て，その時々の民意をより反映しているといえることが衆議院優越の根拠であると解される。[№15]","requires_context":false,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[155,157]}},{"id":"yobi-2012-kenpo-q09-b","question_id":"yobi-2012-kenpo-q09","label":"イ","text":"衆議院が可決した法律案を参議院が可決しなかった場合には，衆議院が出席議員の３分の２以上の多数で再び可決して法律として成立させることができるが，衆議院の再議決の前には両院協議会を開くことが憲法上求められている。[№16]","requires_context":false,"truth_at_exam":{"value":false,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[158,160]}},{"id":"yobi-2012-kenpo-q09-c","question_id":"yobi-2012-kenpo-q09","label":"ウ","text":"憲法は条約について，内閣が締結権を有するとしながらも，国会による承認を経ることを求めている。その際には，案件を先に衆議院に提出しなければならず，また議決についても，法律案の場合よりも衆議院の強い優越性が認められている。[№17]","requires_context":false,"truth_at_exam":{"value":false,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[161,163]}},{"id":"yobi-2012-kenpo-q10-a","question_id":"yobi-2012-kenpo-q10","label":"ア","text":"「板まんだら」事件判決（最三小判昭和５６年４月７日）は，宗教上の教義や信仰に関わる紛争について裁判所は厳に中立を保つべきであるとして，これらの事項が訴訟の前提問題に含まれている場合には，当該訴訟は法律上の争訟に当たらないとしたものである。[№18]","requires_context":false,"truth_at_exam":{"value":false,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[169,171]}},{"id":"yobi-2012-kenpo-q10-b","question_id":"yobi-2012-kenpo-q10","label":"イ","text":"苫米地事件判決（最大判昭和３５年６月８日）は，法律上の争訟の要件が満たされる事案であっても，高度の政治性を有する国家行為に関しては，実際的必要性の観点から，裁判所が司法判断を下すのを自制すべきであるとしたものである。[№19]","requires_context":false,"truth_at_exam":{"value":false,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[172,174]}},{"id":"yobi-2012-kenpo-q10-c","question_id":"yobi-2012-kenpo-q10","label":"ウ","text":"警察法改正無効事件判決（最大判昭和３７年３月７日）は，警察法改正が衆参両院において議決を経たとされ，適法な手続で公布されている以上，裁判所は両院の自主性を尊重すべきであり，議事手続に関する事実を審理してその有効無効を判断すべきでないとしたものである。[№20]","requires_context":false,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[175,178]}},{"id":"yobi-2012-kenpo-q11-a","question_id":"yobi-2012-kenpo-q11","label":"ア","text":"憲法優位説の論拠の一つは，条約優位説がもたらす結果に対する批判である。それは，条約締結要件が憲法改正手続よりも緩やかであるので，条約によって実質的に憲法を改正することも可能になることへの批判である。[№21]","requires_context":false,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[185,187]}},{"id":"yobi-2012-kenpo-q11-b","question_id":"yobi-2012-kenpo-q11","label":"イ","text":"憲法優位説によれば，条約締結権を定めている憲法の規定は，どの機関が条約締結を担うのか，またどのような手続を必要とするのかについて定めたものであって，条約の効力の根拠を定めたものではない。[№22]","requires_context":false,"truth_at_exam":{"value":false,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[188,190]}},{"id":"yobi-2012-kenpo-q11-c","question_id":"yobi-2012-kenpo-q11","label":"ウ","text":"憲法優位説の中にも，条約の違憲審査を控えるべきであるとする考え方がある。それは，憲法第８１条の文言に条約が含まれていないことや憲法第９８条第２項が条約の誠実遵守を宣言していることを根拠とする。[№23]","requires_context":false,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[191,193]}},{"id":"yobi-2012-kenpo-q12-a","question_id":"yobi-2012-kenpo-q12","label":"ア","text":"憲法改正権は，憲法制定権力発動の所産である憲法に根拠を有する以上，憲法の同質性を失わせるような改正をする法的能力を持ち得ない。","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[203,204]}},{"id":"yobi-2012-kenpo-q12-b","question_id":"yobi-2012-kenpo-q12","label":"イ","text":"ある憲法の基本原理が所定の憲法改正手続に従って改正されたとすれば，それは憲法の廃止と新憲法の制定という，法を超えた政治的事件ということになる。","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[205,206]}},{"id":"yobi-2012-kenpo-q12-c","question_id":"yobi-2012-kenpo-q12","label":"ウ","text":"日本国憲法は，大日本帝国憲法に定められた憲法改正手続を遵守して制定されており，その全面改正として法的には有効に成立した。","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[207,208]}}],"explanations":[]}