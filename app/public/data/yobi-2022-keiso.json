reviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[520,522]}},{"id":"yobi-2022-keiso-q21-e","question_id":"yobi-2022-keiso-q21","label":"オ","text":"公判前整理手続に付された事件については、検察官及び被告人又は弁護人は、やむを得ない事由によって公判前整理手続において請求することができなかったものを除き、当該公判前整理手続が終わった後には、証拠調べを請求することができない。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"combination","basis":"uniqueness","derived_from":{"slots":[{"no":27,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[523,525]}},{"id":"yobi-2022-keiso-q22-a","question_id":"yobi-2022-keiso-q22","label":"ア","text":"裁判所は、弁護人が出頭している法廷で証人を尋問する場合において、証人が被告人の面前においては圧迫を受け充分な供述をすることができないと認めるときは、証人と被告人の間の遮へい措置又はビデオリンク方式が採られている場合を除き、検察官及び弁護人の意見を聴き、その証人の供述中被告人を退廷させることができる。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"combination","basis":"selected","derived_from":{"slots":[{"no":28,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[535,538]}},{"id":"yobi-2022-keiso-q22-b","question_id":"yobi-2022-keiso-q22","label":"イ","text":"裁判所は、証人を尋問する場合において、証人の年齢、心身の状態その他の事情を考慮し、証人が著しく不安又は緊張を覚えるおそれがあると認めるときは、検察官及び被告人又は弁護人の意見を聴き、その不安又は緊張を緩和するのに適当であり、かつ、裁判官若しくは訴訟関係人の尋問若しくは証人の供述を妨げ、又はその供述の内容に不当な影響を与えるおそれがないと認める者を、その証人の供述中、証人に付き添わせることができる。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"combination","basis":"convention","derived_from":{"slots":[{"no":28,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[539,543]}},{"id":"yobi-2022-keiso-q22-c","question_id":"yobi-2022-keiso-q22","label":"ウ","text":"裁判所は、被害者等が意見陳述をする場合において、被害者等の年齢、心身の状態その他の事情を考慮し、被害者等が著しく不安又は緊張を覚えるおそれがあると認めるときは、検察官及び被告人又は弁護人の意見を聴き、その不安又は緊張を緩和するのに適当であり、かつ、裁判官若しくは訴訟関係人の尋問若しくは被害者等の供述を妨げ、又はその供述の内容に不当な影響を与えるおそれがないと認める者を、被害者等の意見陳述中、被害者等に付き添わせることができる。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"combination","basis":"uniqueness","derived_from":{"slots":[{"no":28,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[544,549]}},{"id":"yobi-2022-keiso-q22-d","question_id":"yobi-2022-keiso-q22","label":"エ","text":"被害者特定事項を公開の法廷で明らかにしない旨の決定があったときは、検察官は、被害者特定事項を明らかにしない方法で起訴状の朗読を行い、起訴状を被告人に示さなければならない。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"combination","basis":"uniqueness","derived_from":{"slots":[{"no":28,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[550,552]}},{"id":"yobi-2022-keiso-q22-e","question_id":"yobi-2022-keiso-q22","label":"オ","text":"裁判所は、被害者特定事項を公開の法廷で明らかにしない旨の決定をすることはできるが、証人、鑑定人、通訳人又は翻訳人に係る特定事項を公開の法廷で明らかにしない旨の決定をすることはできない。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"combination","basis":"selected","derived_from":{"slots":[{"no":28,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[553,555]}},{"id":"yobi-2022-keiso-q23-a","question_id":"yobi-2022-keiso-q23","label":"ア","text":"Ⅰの見解は、本条は、物質の排出と公衆の生命又は身体の危険の発生との因果関係につき、被告人に挙証責任を転換する規定であるとするものである。","requires_context":true,"truth_at_exam":{"value":true,"derivation":"combination","basis":"selected","derived_from":{"slots":[{"no":29,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[574,575]}},{"id":"yobi-2022-keiso-q23-b","question_id":"yobi-2022-keiso-q23","label":"イ","text":"Ⅰの見解は、被告人は、自らが排出した物質によって公衆の生命又は身体の危険が生じたものではないことを、合理的な疑いを超える程度に立証しなければならないとするものである。","requires_context":true,"truth_at_exam":{"value":false,"derivation":"combination","basis":"convention","derived_from":{"slots":[{"no":29,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[576,577]}},{"id":"yobi-2022-keiso-q23-c","question_id":"yobi-2022-keiso-q23","label":"ウ","text":"Ⅱの見解によれば、被告人が、自らが排出した物質によって公衆の生命又は身体の危険が生じたものではないことを立証できなかった場合に、その危険が被告人の排出した物質によって生じたものと認定するかどうかは、裁判所の裁量に委ねられることになる。","requires_context":true,"truth_at_exam":{"value":false,"derivation":"combination","basis":"uniqueness","derived_from":{"slots":[{"no":29,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[578,580]}},{"id":"yobi-2022-keiso-q23-d","question_id":"yobi-2022-keiso-q23","label":"エ","text":"Ⅱの見解に対しては、それによると、本条は「疑わしきは被告人の利益に」の原則に反することになるとする批判がある。","requires_context":true,"truth_at_exam":{"value":false,"derivation":"combination","basis":"uniqueness","derived_from":{"slots":[{"no":29,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[581,582]}},{"id":"yobi-2022-keiso-q23-e","question_id":"yobi-2022-keiso-q23","label":"オ","text":"Ⅱの見解は、本条は、被告人が、自らが排出した物質によって公衆の生命又は身体の危険が生じていないという立証ができないことを、一つの情況証拠とすることを認める規定であるとするものである。","requires_context":true,"truth_at_exam":{"value":true,"derivation":"combination","basis":"selected","derived_from":{"slots":[{"no":29,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[583,585]}},{"id":"yobi-2022-keiso-q24-a","question_id":"yobi-2022-keiso-q24","label":"ア","text":"違法に収集された証拠物の証拠能力については、刑事訴訟法に何らの規定も置かれていないので、この問題は、刑事訴訟法の解釈ではなく、憲法の解釈に委ねられている。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":30,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[601,602]}},{"id":"yobi-2022-keiso-q24-b","question_id":"yobi-2022-keiso-q24","label":"イ","text":"違法収集証拠排除法則の目的は、法の適正な手続を保障し司法の廉潔さを保持することであって、将来における違法捜査を抑制することではない。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":31,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[603,604]}},{"id":"yobi-2022-keiso-q24-c","question_id":"yobi-2022-keiso-q24","label":"ウ","text":"違法に収集された証拠物の証拠能力が否定されるかの判断に当たって、捜査の違法の程度は考慮されるが、当該証拠の重要性は考慮されない。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":32,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[605,606]}},{"id":"yobi-2022-keiso-q24-d","question_id":"yobi-2022-keiso-q24","label":"エ","text":"違法に収集された証拠物の証拠能力が否定されるかの判断に当たって、捜査機関が当該証拠の押収までに行ったことは考慮されるが、押収後に行ったことが考慮されることはない。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":33,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[607,609]}},{"id":"yobi-2022-keiso-q24-e","question_id":"yobi-2022-keiso-q24","label":"オ","text":"違法な逮捕に引き続く身体拘束中に覚醒剤使用の証拠となる尿を被疑者が任意提出した場合、逮捕が覚醒剤使用ではなく窃盗を理由とするものであれば、尿の証拠能力は否定されない。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":34,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[610,613]}},{"id":"yobi-2022-keiso-q25-a","question_id":"yobi-2022-keiso-q25","label":"ア","text":"Ⅰの見解に対しては、自白の内容が真実と認められれば、証拠として許容されることになるのではないかとの批判がある。","requires_context":true,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":35,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[629,630]}},{"id":"yobi-2022-keiso-q25-b","question_id":"yobi-2022-keiso-q25","label":"イ","text":"Ⅱの見解に対しては、供述者の主観的な心理状態に関する事実認定が困難であるという批判がある。","requires_context":true,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":36,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[631,632]}},{"id":"yobi-2022-keiso-q25-c","question_id":"yobi-2022-keiso-q25","label":"ウ","text":"Ⅲの見解に対しては、違法な手続により得られた自白の全てが任意にされたものでない疑いがあるとはいえないから、そのような自白が全て刑事訴訟法第３１９条第１項により排除されるとするのであれば、規定の文言上無理があるという批判がある。","requires_context":true,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":37,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[633,635]}},{"id":"yobi-2022-keiso-q25-d","question_id":"yobi-2022-keiso-q25","label":"エ","text":"ⅠとⅡの見解によれば、強制等による自白や不当に長く抑留又は拘禁された後の自白を不任意自白の例示とみることができる。","requires_context":true,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":38,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[636,637]}},{"id":"yobi-2022-keiso-q25-e","question_id":"yobi-2022-keiso-q25","label":"オ","text":"Ⅲの見解によると、被告人側から取調官側に視点を移して、自白獲得手段自体の違法性に着目することになり、刑事訴訟法第３１９条第１項が「強制、拷問又は脅迫」、「不当に長く抑留又は拘禁」などと、自白獲得の手段を列挙していることにも合致すると主張することができる。","requires_context":true,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":39,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[638,641]}},{"id":"yobi-2022-keiso-q26-a","question_id":"yobi-2022-keiso-q26","label":"ア","text":"補強証拠は、自白に係る犯罪組成事実の全部にわたって、もれなく、これを裏付けするようなものでなければならないわけではなく、自白に係る事実の真実性を保障し得るものであれば足りる。","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[651,653]}},{"id":"yobi-2022-keiso-q26-b","question_id":"yobi-2022-keiso-q26","label":"イ","text":"無免許運転の罪においては、運転行為のみならず、運転免許を受けていなかったという事実についても、被告人の自白のほかに、補強証拠が必要である。","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[654,655]}},{"id":"yobi-2022-keiso-q26-c","question_id":"yobi-2022-keiso-q26","label":"ウ","text":"自白以外の補強証拠によって、既に犯罪の客観的事実が認められ得る場合においては、犯意や知情といった犯罪の主観面について、自白が唯一の証拠であっても差し支えない。","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[656,657]}},{"id":"yobi-2022-keiso-q26-d","question_id":"yobi-2022-keiso-q26","label":"エ","text":"自白以外の補強証拠によって、犯罪が架空のものではなく、現実に行われたものであることが証明される場合においても、被告人の自白した犯罪が被告人によって行われたという、犯罪と被告人との結び付きについては、補強証拠が必要である。","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[658,660]}},{"id":"yobi-2022-keiso-q26-e","question_id":"yobi-2022-keiso-q26","label":"オ","text":"補強証拠の証明力については、自白と補強証拠とが相まって犯罪構成要件たる事実を総体的に認定することができればそれで足り、補強証拠だけでその事実を立証できる程度の証明力までは必要ない。","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[661,663]}}],"explanations":[]}