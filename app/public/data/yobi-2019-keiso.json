ots":[{"no":20,"official_answer":5}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[328,330]}},{"id":"yobi-2019-keiso-q14-b","question_id":"yobi-2019-keiso-q14","label":"イ","text":"刑事訴訟法は，裁判所が審判を行うことのできる対象について，検察官が「訴因」として明示する犯罪事実に限定されることはなく，当該犯罪事実と「公訴事実の同一性」の関係が認められる事実にまで及ぶとすることにより，審判対象設定における「当事者主義」を採用した。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"combination","basis":"uniqueness","derived_from":{"slots":[{"no":20,"official_answer":5}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[331,333]}},{"id":"yobi-2019-keiso-q14-c","question_id":"yobi-2019-keiso-q14","label":"ウ","text":"刑事訴訟法が「起訴状一本主義」を採用したことにより，公判における事実審理を裁判所が主導して行う「職権主義」は実際上困難となり，当事者による証拠調べ請求や交互尋問など，「当事者主義」による訴訟追行が原則として行われることとなった。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"combination","basis":"selected","derived_from":{"slots":[{"no":20,"official_answer":5}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[334,336]}},{"id":"yobi-2019-keiso-q14-d","question_id":"yobi-2019-keiso-q14","label":"エ","text":"犯罪事実については，その存在が証明されたとの心証を裁判所が抱いたのでない限り無罪が言い渡されるという意味で，検察官が「挙証責任」を負うとされるが，これは，刑事訴訟法が「当事者主義」による訴訟追行を原則としたことによるものであり，「職権主義」の下では，検察官が犯罪事実について「挙証責任」を負うことはない。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"combination","basis":"convention","derived_from":{"slots":[{"no":20,"official_answer":5}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[337,340]}},{"id":"yobi-2019-keiso-q14-e","question_id":"yobi-2019-keiso-q14","label":"オ","text":"確定した判決の言渡しを受けた者にとって不利益となる再審を認めることは，「二重の危険の禁止」に反する疑いがあるため，刑事訴訟法は，確定した有罪判決の言渡しを受けた者にとって利益な方向での再審のみを認めた。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"combination","basis":"selected","derived_from":{"slots":[{"no":20,"official_answer":5}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[341,343]}},{"id":"yobi-2019-keiso-q15-a","question_id":"yobi-2019-keiso-q15","label":"ア","text":"捜査機関は，逮捕状により被疑者を逮捕する場合において，被疑者を捜索するため人の住居に入る必要があるときは，住居を対象とする捜索許可状がなくても，その住居に入ることができる。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"combination","basis":"selected","derived_from":{"slots":[{"no":21,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[350,352]}},{"id":"yobi-2019-keiso-q15-b","question_id":"yobi-2019-keiso-q15","label":"イ","text":"捜査機関が捜索差押許可状により人の住居を捜索する場合において，差し押さえるべき物が短時間のうちに破棄隠匿されるおそれがあり，捜索差押えの実効性を確保するためにやむを得ないと認められるときは，令状を呈示することなくその住居に入った後，直ちに令状を呈示して捜索をすることができる。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"combination","basis":"selected","derived_from":{"slots":[{"no":21,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[353,356]}},{"id":"yobi-2019-keiso-q15-c","question_id":"yobi-2019-keiso-q15","label":"ウ","text":"捜査機関が捜索差押許可状により人の住居を捜索する場合において，急速を要するときは，令状に夜間でも捜索することができる旨の記載がなくても，日没後にその住居に入り捜索をすることができる。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"combination","basis":"uniqueness","derived_from":{"slots":[{"no":21,"official_answer":1}]}},"truth_current":{"statu