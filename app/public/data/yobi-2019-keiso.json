":"yobi-2019-keiso-q16-c","question_id":"yobi-2019-keiso-q16","label":"ウ","text":"現行犯逮捕が許されるためには，逮捕者が，少なくとも犯行の一部を現認していることが必要である。","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[379,380]}},{"id":"yobi-2019-keiso-q16-d","question_id":"yobi-2019-keiso-q16","label":"エ","text":"私人が現行犯人を逮捕したときは，直ちにこれを地方検察庁若しくは区検察庁の検察官又は司法警察職員に引き渡さなければならない。","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[381,382]}},{"id":"yobi-2019-keiso-q16-e","question_id":"yobi-2019-keiso-q16","label":"オ","text":"現行犯人を逮捕した私人は，逮捕の現場で令状によらずに，証拠物の捜索差押えをすることができる。","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[383,384]}},{"id":"yobi-2019-keiso-q17-a","question_id":"yobi-2019-keiso-q17","label":"ア","text":"裁判官は，勾留の請求を受けた時から２４時間以内に勾留の裁判をしなければならない。","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[391,391]}},{"id":"yobi-2019-keiso-q17-b","question_id":"yobi-2019-keiso-q17","label":"イ","text":"勾留の請求を受けた裁判官は，被疑者に被疑事件を告げる際，被疑者が既に弁護人を選任している場合には，弁護人選任権を告げる必要はない。","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[392,393]}},{"id":"yobi-2019-keiso-q17-c","question_id":"yobi-2019-keiso-q17","label":"ウ","te