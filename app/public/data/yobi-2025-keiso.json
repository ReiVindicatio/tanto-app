range":[736,738]}},{"id":"yobi-2025-keiso-q25-d","question_id":"yobi-2025-keiso-q25","label":"エ","text":"同項第２号ただし書の「前の供述を信用すべき特別の情況」（相対的特信情況）は、供述がなされた際の外部的・付随的情況を指すから、その存否を判断する際に供述内容自体を考慮することはできない。","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[739,741]}},{"id":"yobi-2025-keiso-q25-e","question_id":"yobi-2025-keiso-q25","label":"オ","text":"被告人以外の者の司法警察員に対する供述調書で供述者の署名又は押印のあるものは、供述者の供述不能の要件が存在し、かつ、その供述が特に信用すべき情況（絶対的特信情況）の下にされたものであることが認められれば、同項第３号により証拠能力が認められる。","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[742,744]}},{"id":"yobi-2025-keiso-q26-a","question_id":"yobi-2025-keiso-q26","label":"ア","text":"Ⅰの見解に対しては、黙秘権を侵害して得られた自白の証拠能力が否定されるのは黙秘権保障の内容そのものであり、黙秘権と自白法則を混同しているという批判がある。","requires_context":true,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":36,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[764,765]}},{"id":"yobi-2025-keiso-q26-b","question_id":"yobi-2025-keiso-q26","label":"イ","text":"Ⅱの見解によったとしても、不任意自白に基づき発見された物は、関連性が不任意自白によらなければ証明されない場合、証拠として許容されない。","requires_context":true,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":37,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[766,767]}},{"id":"yobi-2025-keiso-q26-c","question_id":"yobi-2025-keiso-q26","label":"ウ","text":"Ⅱの見解によれば、強制、拷問又は脅迫による自白、不当に長く抑留又は拘禁された後の自白は、不任意自白の例示とみることができる。","requires_context":true,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":38,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[768,769]}},{"id":"yobi-2025-keiso-q26-d","question_id":"yobi-2025-keiso-q26","label":"エ","text":"Ⅲの見解に対しては、違法な手続により得られた自白の全てが任意にされたものでない疑いがあるとはいえないから、そのような自白が全て刑事訴訟法第３１９条第１項により排除されるとするのであれば、規定の文言上無理があるという批判がある。","requires_context":true,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":39,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[770,772]}},{"id":"yobi-2025-keiso-q26-e","question_id":"yobi-2025-keiso-q26","label":"オ","text":"Ⅲの見解によれば、取調官が偽計を用いて得た供述は、供述者の主観的な心理状態に影響を及ぼした疑いがある場合に限り、証拠能力が否定される。","requires_context":true,"truth_at_exam":{"value":false,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":40,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[773,774]}}],"explanations":[]}