truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[461,463]}},{"id":"yobi-2025-keiso-q15-d","question_id":"yobi-2025-keiso-q15","label":"エ","text":"検察官は、下線部③の果物ナイフにつき、犯行に使用された果物ナイフとの同一性をＶに尋問する場合において必要があるときは、裁判長の許可を受けずにこれを示すことができる。","requires_context":true,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":24,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[464,466]}},{"id":"yobi-2025-keiso-q15-e","question_id":"yobi-2025-keiso-q15","label":"オ","text":"検察官は、証拠調べが終わっていない下線部④の実況見分調書をＸに示して、その成立の真正について尋問することは許されない。","requires_context":true,"truth_at_exam":{"value":false,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":25,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[467,468]}},{"id":"yobi-2025-keiso-q16-a","question_id":"yobi-2025-keiso-q16","label":"ア","text":"Ⅰの見解でも、Ｂ事実による身体拘束期間にＢ事実の取調べと並行してＡ事実の取調べを行った場合、その身体拘束が違法にならないことがある。","requires_context":true,"truth_at_exam":{"value":true,"derivation":"combination","basis":"uniqueness","derived_from":{"slots":[{"no":26,"official_answer":3}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[489,490]}},{"id":"yobi-2025-keiso-q16-b","question_id":"yobi-2025-keiso-q16","label":"イ","text":"Ⅱの見解では、Ｂ事実による身体拘束が適法に行われたものである以上、仮にその身体拘束期間中に専らＡ事実の取調べが行われており、Ｂ事実の取調べが全く行われていないような場合でも、Ａ事実の取調べが違法となることはない。","requires_context":true,"truth_at_exam":{"value":false,"derivation":"combination","basis":"selected","derived_from":{"slots":[{"no":26,"official_answer":3}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[491,493]}},{"id":"yobi-2025-keiso-q16-c","question_id":"yobi-2025-keiso-q16","label":"ウ","text":"Ⅲの見解は、逮捕・勾留期間につき、その理由とされた被疑事実について被疑者の逃亡・罪証隠滅を防止した状態で起訴・不起訴の決定に向けた捜査を行う期間であると捉える考えと整合しない。","requires_context":true,"truth_at_exam":{"value":false,"derivation":"combination","basis":"selected","derived_from":{"slots":[{"no":26,"official_answer":3}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[494,496]}},{"id":"yobi-2025-keiso-q16-d","question_id":"yobi-2025-keiso-q16","label":"エ","text":"Ⅰの見解に対しては、逮捕・勾留の場面において、裁判官が捜査機関の意図・目的を審査することは現実的には容易ではないとの批判がある。","requires_context":true,"truth_at_exam":{"value":true,"derivation":"combination","basis":"convention","derived_from":{"slots":[{"no":26,"official_answer":3}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[497,498]}},{"id":"yobi-2025-keiso-q16-e","question_id":"yobi-2025-keiso-q16","label":"オ","text":"Ⅱの見解に対しては、捜査機関による身体拘束の濫用という問題の本質を無視する考え方であるとの批判がある。","requires_context":true,"truth_at_exam":{"value":true,"derivation":"combination","basis":"uniqueness","derived_from":{"slots":[{"no":26,"official_answer":3}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[499,500]}},{"id":"yobi-2025-keiso-q17-a","question_id":"yobi-2025-keiso-q17","label":"ア","text":"本件逮捕は窃盗被疑事実の嫌疑に基づくものである一方で、本件採尿やその尿の鑑定は覚醒剤自己使用の被疑事実の嫌疑に基づくもので、本件鑑定書は後者の事実の立証に用いられるものであるから、本件逮捕の違法が、本件鑑定書の証拠能力に影響を及ぼすことはない。","requires_context":true,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[528,530]}},{"id":"yobi-2025-keiso-q17-b","question_id":"yobi-2025-keiso-q17","label":"イ","text":"違法収集証拠排除法則によって証拠が排除されるための要件である「違法の重大性」と「排除相当性」のうち、「違法の重大性」は、手続の客観的な違法の程度に着目するものであるから、その要件を充足するか否かの判断に際して、捜査機関側の主観的事情が考慮されることはない。","requires_context":true,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[531,534]}},{"id":"yobi-2025-keiso-q17-c","question_id":"yobi-2025-keiso-q17","label":"ウ","text":"本件逮捕の違法を糊塗する目的でされた逮捕状への虚偽記載や公判廷での事実に反する証言等は、本件逮捕後にされたものであるから、これらの行為の存在が本件逮捕自体の違法性の程度に影響を及ぼすことはない。","requires_context":true,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[535,537]}},{"id":"yobi-2025-keiso-q17-d","question_id":"yobi-2025-keiso-q17","label":"エ","text":"違法な手続と最終的に獲得された証拠との間の因果性（関連性）の程度は、「違法の重大性」の判断における考慮要素であり、「排除相当性」の判断においては考慮されないから、本件逮捕と本件鑑定書との間の因果性（関連性）の程度が、本件鑑定書の「排除相当性」の判断に影響を及ぼすことはない。","requires_context":true,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[538,541]}},{"id":"yobi-2025-keiso-q17-e","question_id":"yobi-2025-keiso-q17","label":"オ","text":"鑑定は専門家によって客観的になされるものであり、その結果を記載した鑑定書は定型的に高度の信頼性を有する証拠といえるから、鑑定の対象となる尿が本件のように逮捕当日に被疑者から任意提出されたもので、重大な違法を伴う逮捕と密接に関連するものであったとしても、そのことが、尿の鑑定書の証拠能力に影響を及ぼすことはない。","requires_context":true,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[542,545]}},{"id":"yobi-2025-keiso-q18-a","question_id":"yobi-2025-keiso-q18","label":"ア","text":"被告人は、裁判員裁判の対象事件ではない事件について、事件を公判前整理手続に付することを求めることができる。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"combination","basis":"uniqueness","derived_from":{"slots":[{"no":28,"official_answer":3}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[555,556]}},{"id":"yobi-2025-keiso-q18-b","question_id":"yobi-2025-keiso-q18","label":"イ","text":"裁判所は、裁判員裁判の対象事件ではない事件について、検察官と弁護人の双方が公判前整理手続に付することを求めている場合には、事件を公判前整理手続に付さなければならない。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"combination","basis":"selected","derived_from":{"slots":[{"no":28,"official_answer":3}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[557,558]}},{"id":"yobi-2025-keiso-q18-c","question_id":"yobi-2025-keiso-q18","label":"ウ","text":"検察官は、公判前整理手続に付された事件において、検察官請求証拠の開示をした後、被告人又は弁護人から請求があったときは、速やかに、被告人又は弁護人に対し、検察官が保管する証拠の一覧表の交付をしなければならない。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"combination","basis":"convention","derived_from":{"slots":[{"no":28,"official_answer":3}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[559,561]}},{"id":"yobi-2025-keiso-q18-d","question_id":"yobi-2025-keiso-q18","label":"エ","text":"検察官は、公判前整理手続において取調べを請求した証人について、被告人又は弁護人に対し、同証人が公判期日において供述すると思料する内容が明らかになる書面等を閲覧する機会を与えなければならない。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"combination","basis":"uniqueness","derived_from":{"slots":[{"no":28,"official_answer":3}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[562,564]}},{"id":"yobi-2025-keiso-q18-e","question_id":"yobi-2025-keiso-q18","label":"オ","text":"裁判所は、公判前整理手続において検察官及び弁護人が行った証拠調べの請求の全てについて、同手続終結までに、証拠調べをする決定又は証拠調べの請求を却下する決定をしなければならない。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"combination","basis":"selected","derived_from":{"slots":[{"no":28,"official_answer":3}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[565,567]}},{"id":"yobi-2025-keiso-q19-a","question_id":"yobi-2025-keiso-q19","label":"ア","text":"検察官Ｙは、令和６年７月１８日正午に勾留を請求しているが、同日午後１時３０分までに勾留を請求すれば足りる。","requires_context":true,"truth_at_exam":{"value":false,"derivation":"combination","basis":"selected","derived_from":{"slots":[{"no":29,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[591,592]}},{"id":"yobi-2025-keiso-q19-b","question_id":"yobi-2025-keiso-q19","label":"イ","text":"検察官Ｙは、裁判官Ｚが、罪証を隠滅すると疑うに足りる相当な理由がないことを理由として勾留請求を却下した場合、これに不服があるときでも、Ｈ地方裁判所に対し、その裁判を取り消して甲を勾留するよう請求することは許されない。","requires_context":true,"truth_at_exam":{"value":false,"derivation":"combination","basis":"selected","derived_from":{"slots":[{"no":29,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[593,595]}},{"id":"yobi-2025-keiso-q19-c","question_id":"yobi-2025-keiso-q19","label":"ウ","text":"詐欺罪の事実について勾留の理由又は必要がなくなった場合、検察官Ｙは、窃盗罪の事実について捜査の必要があることを理由として甲の勾留を継続することは許されない。","requires_context":true,"truth_at_exam":{"value":true,"derivation":"combination","basis":"uniqueness","derived_from":{"slots":[{"no":29,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[596,597]}},{"id":"yobi-2025-keiso-q19-d","question_id":"yobi-2025-keiso-q19","label":"エ","text":"検察官Ｙが、窃盗罪の事実について甲を逮捕しないまま、詐欺罪の事実に窃盗罪の事実を併せて勾留を請求した場合、勾留請求を受けた裁判官は、詐欺及び窃盗のいずれについても勾留の理由及び必要性が認められると判断したとき、両罪について勾留状を発付することができる。","requires_context":true,"truth_at_exam":{"value":true,"derivation":"combination","basis":"convention","derived_from":{"slots":[{"no":29,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[598,600]}},{"id":"yobi-2025-keiso-q19-e","question_id":"yobi-2025-keiso-q19","label":"オ","text":"甲の勾留期間の満了日は、令和６年７月２７日である。","requires_context":true,"truth_at_exam":{"value":true,"derivation":"combination","basis":"uniqueness","derived_from":{"slots":[{"no":29,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[601,601]}},{"id":"yobi-2025-keiso-q20-a","question_id":"yobi-2025-keiso-q20","label":"ア","text":"下線部①につき、Ｘは、金属バットを押収するに当たり、裁判官による令状の発付を受ける必要がある。","requires_context":true,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[628,629]}},{"id":"yobi-2025-keiso-q20-b","question_id":"yobi-2025-keiso-q20","label":"イ","text":"下線部②につき、Ｘは、甲を尾行するに当たり、裁判官による令状の発付を受ける必要がある。","requires_context":true,"truth_at_exam":null,"truth_current":{"st