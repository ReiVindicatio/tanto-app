swer_pdf":"data/raw/予備試験/短答/H23-2011/憲法行政法_正答.pdf","page":6,"line_range":[216,234],"extraction":"pdftotext"},"flags":[]}],"statements":[{"id":"yobi-2011-kenpo-q01-a","question_id":"yobi-2011-kenpo-q01","label":"ア","text":"「宴のあと」事件判決（東京地判昭和３９年９月２８日）は，いわゆるプライバシー権は私生活をみだりに公開されないという法的保障ないし権利であるとし，公開を欲するか否かについては，本人の感受性を基準にして判断するとした。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":1,"official_answer":5}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[14,16]},"same_as":[{"id":"shiho-2011-kenpo-q03-a","exam":"司法","era":"H23","year":2011,"number":3,"label":"ア"}]},{"id":"yobi-2011-kenpo-q01-b","question_id":"yobi-2011-kenpo-q01","label":"イ","text":"京都府学連事件判決（最大判昭和４４年１２月２４日）は，個人の私生活上の自由として，何人もその承諾なしにみだりにその容貌・姿態を撮影されない自由を有するとし，警察官が正当な理由もないのに個人の容貌等を撮影することは，憲法第１３条の趣旨に反するとした。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":1,"official_answer":5}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[17,19]},"same_as":[{"id":"shiho-2011-kenpo-q03-b","exam":"司法","era":"H23","year":2011,"number":3,"label":"イ"}]},{"id":"yobi-2011-kenpo-q01-c","question_id":"yobi-2011-kenpo-q01","label":"ウ","text":"講演会参加者名簿提出事件判決（最二小判平成１５年９月１２日)は，大学が学生から収集した参加申込者の学籍番号，氏名，住所及び電話番号は，プライバシーに係る情報として法的保護の対象となるとし，個人の人格的な権利利益を損なうおそれがあるものであるとした。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":1,"official_answer":5}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[20,22]},"same_as":[{"id":"shiho-2011-kenpo-q03-c","exam":"司法","era":"H23","year":2011,"number":3,"label":"ウ"}]},{"id":"yobi-2011-kenpo-q02-a","question_id":"yobi-2011-kenpo-q02","label":"ア","text":"ａ．謝罪広告を新聞紙に掲載すべきことを命ずることは，憲法第１９条が保障する良心の自由を侵害するものではない。ｂ．憲法第１９条の「良心」には道徳的反省や誠実さは含まれないので，単に事態の真相を告白し，陳謝の意を表明する程度の強制は認められる。[№２]","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[33,36]}},{"id":"yobi-2011-kenpo-q02-b","question_id":"yobi-2011-kenpo-q02","label":"イ","text":"ａ．内申書に記載されたのは事実である外部的行為であり，それによってその者の思想，信条を了知し得るものではない。ｂ．思想，信条とその者の外部的行為の間の密接な関係を認めた三菱樹脂事件判決（最大判昭和４８年１２月１２日）の趣旨と相違する。[№３]","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[37,40]}},{"id":"yobi-2011-kenpo-q02-c","question_id":"yobi-2011-kenpo-q02","label":"ウ","text":"ａ．本件における使用者による労働者の政党所属調査は，社会的に許容し得る限界を超えて労働者の思想の自由を侵害した違法行為であるということはできない。ｂ．労働者の思想信条は，これを理由とする労働条件の差別的取扱いの有無にかかわらず，それ自体において憲法第１９条に即して尊重されるべきである。[№４]","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[41,44]}},{"id":"yobi-2011-kenpo-q03-a","question_id":"yobi-2011-kenpo-q03","label":"ア","text":"広告物が貼付されている場所の性質，周囲の状況，広告物の数量や形状，貼付の仕方等を総合的に考慮し，地域の美観風致の侵害の程度と当該広告物に表れた表現の持つ価値とを比較衡量してその規制の合憲性を判断すべきである。[№５]","requires_context":false,"truth_at_exam":{"value":false,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[51,53]}},{"id":"yobi-2011-kenpo-q03-b","question_id":"yobi-2011-kenpo-q03","label":"イ","text":"裁判官による積極的な政治運動の禁止の目的は，裁判官の独立及び中立・公正の確保に対する国民の信頼の維持，そして司法と立法・行政とのあるべき関係を規律することであるので，その要請は，一般職の国家公務員に対する政治的行為の禁止の要請よりも強いものというべきである。[№６]","requires_context":false,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[54,59]}},{"id":"yobi-2011-kenpo-q03-c","question_id":"yobi-2011-kenpo-q03","label":"ウ","text":"問題となっている写真集のわいせつ性については，芸術など性的刺激を緩和させる要素の存在，問題となっている各写真の写真集に占める比重，作者に対する当該分野の評論家からの評価，その表現手法等の観点から，写真集を全体としてみて判断すべきである。[№７]","requires_context":false,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[60,62]}},{"id":"yobi-2011-kenpo-q04-a","question_id":"yobi-2011-kenpo-q04","label":"ア","text":"国民各自は，一個の人間として，また一市民として，成長，発達し，自己の人格を完成，実現するために必要な学習する固有の権利を有し，特に，子どもは，そのための教育を自己に施すことを大人一般に対して要求する権利を有する。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":8,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[70,72]},"same_as":[{"id":"shiho-2011-kenpo-q09-a","exam":"司法","era":"H23","year":2011,"number":9,"label":"ア"}]},{"id":"yobi-2011-kenpo-q04-b","question_id":"yobi-2011-kenpo-q04","label":"イ","text":"個人の基本的自由を認め，その人格の独立を国政上尊重すべきものとしている憲法の下においては，子どもが自由かつ独立の人格として成長することを妨げるような国家的介入は，許されない。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":8,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[73,75]},"same_as":[{"id":"shiho-2011-kenpo-q09-b","exam":"司法","era":"H23","year":2011,"number":9,"label":"イ"}]},{"id":"yobi-2011-kenpo-q04-c","question_id":"yobi-2011-kenpo-q04","label":"ウ","text":"子どもの教育は，専ら子どもの利益のために，教育を与える者の責務として行われるべきものであるから，教育の内容及び方法については，その実施に当たる教師が，教育専門家としての立場から，決定し遂行すべきものである。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":8,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[76,78]},"same_as":[{"id":"shiho-2011-kenpo-q09-c","exam":"司法","era":"H23","year":2011,"number":9,"label":"ウ"}]},{"id":"yobi-2011-kenpo-q05-a","question_id":"yobi-2011-kenpo-q05","label":"ア","text":"国又は公共団体の行為が，いわゆる非権力的な管理作用に属する場合は，大日本帝国憲法下でも判例上民法第７０９条以下の規定による不法行為責任がある程度まで認められていた。それゆえ，日本国憲法第１７条の意義は，権力作用に属する不法行為との関係で国家無答責の原則を否定し，国家の賠償責任を明記した点にあるということができる。[№９]","requires_context":false,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[87,90]}},{"id":"yobi-2011-kenpo-q05-b","question_id":"yobi-2011-kenpo-q05","label":"イ","text":"日本国憲法第１７条は，国又は公共団体に対し損害賠償を求める権利について，「法律の定めるところにより」として，その法律による具体化を予定している。これは公務員のどのような行為によりいかなる要件で賠償責任を負うかを全面的に立法府の裁量判断に委ねる趣旨であるから，このような法律の定めが同条に反することはないと解される。[№10]","requires_context":false,"truth_at_exam":{"value":false,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[91,94]}},{"id":"yobi-2011-kenpo-q05-c","question_id":"yobi-2011-kenpo-q05","label":"ウ","text":"最高裁判所は，かつて，例え立法の内容が憲法に違反するものであっても国会議員の立法行為は国家賠償法第１条第１項の適用上当然に違法の評価を受けるものではないとしていた。しかし，最高裁判所は，その後判例を変更し，国会で議決された法律が違憲であれば国家賠償法上も違法の評価を受けることになるという立場を採るに至った。[№11]","requires_context":false,"truth_at_exam":{"value":false,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[95,98]}},{"id":"yobi-2011-kenpo-q06-a","question_id":"yobi-2011-kenpo-q06","label":"ア","text":"ａ．憲法第３１条は，文字どおり，刑罰を科する場合には，法律で定める手続によらなければならないという要求のみを規定したものである。ｂ．条例は地方公共団体が制定する自主立法であるから，刑罰を科する場合の手続を条例で定めることも許される。[№12]","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[108,111]}},{"id":"yobi-2011-kenpo-q06-b","question_id":"yobi-2011-kenpo-q06","label":"イ","text":"ａ．憲法第３１条は，刑罰を科する場合の手続が法律で定められなければならないということと，手続が適正なものでなければならないということを規定したものである。ｂ．憲法第３１条は，罪刑法定主義を定めた規定ではなく，その根拠は憲法の別の条文に求めなければならない。[№13]","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[112,115]}},{"id":"yobi-2011-kenpo-q06-c","question_id":"yobi-2011-kenpo-q06","label":"ウ","text":"ａ．憲法第３１条は，刑罰を科する場合の手続の法定とその適正のみならず，実体の法定とその適正をも要求する規定である。ｂ．処罰の必要性及び合理性，罪刑の均衡を要求する根拠は，憲法第３１条に求められる。[№14]","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[116,119]}},{"id":"yobi-2011-kenpo-q07-a","question_id":"yobi-2011-kenpo-q07","label":"ア","text":"ａ．比例代表制によって選出された国会議員が当該政党の所属でなくなった場合，当該議員は議席を喪失する。ｂ．実際には有権者は選挙において政党を重視しており，全国民の代表であることも公的役割を担う政党への所属を前提としている。[№15]","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[126,129]}},{"id":"yobi-2011-kenpo-q07-b","question_id":"yobi-2011-kenpo-q07","label":"イ","text":"ａ．比例代表制によって選出された国会議員が当該政党の所属でなくなった場合でも，当該議員は議席を喪失しない。ｂ．比例代表制はあくまでも議員の選出方法に過ぎず，一旦選出されれば個々の議員は全国民の代表である。[№16]","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[130,133]}},{"id":"yobi-2011-kenpo-q07-c","question_id":"yobi-2011-kenpo-q07","label":"ウ","text":"ａ．比例代表制によって選出された国会議員が自発的に当該政党の所属でなくなった場合に限り，当該議員は議席を喪失する。ｂ．比例代表選出の国会議員であっても，政党から自由に意思を形成できる全国民の代表である。[№17]","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[134,137]}},{"id":"yobi-2011-kenpo-q08-a","question_id":"yobi-2011-kenpo-q08","label":"ア","text":"憲法第９条は，我が国が主権国として持つ固有の自衛権を否定するものではない。憲法前文の趣旨からして，憲法第９条は，国際連合のような国際機関にばかりでなく，他国に安全保障を求めることを禁じるものではない。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":18,"official_answer":3}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[144,146]}},{"id":"yobi-2011-kenpo-q08-b","question_id":"yobi-2011-kenpo-q08","label":"イ","text":"憲法第９条第２項にいう「戦力」とは，我が国がその主体となって指揮権，管理権を行使し得る戦力をいう。我が国に駐留する外国の軍隊がここにいう戦力に該当するか否かの判断は，裁判所の司法審査権の範囲外である。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":18,"official_answer":3}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[147,149]}},{"id":"yobi-2011-kenpo-q08-c","question_id":"yobi-2011-kenpo-q08","label":"ウ","text":"憲法第９条は国の基本的な法秩序を示した規定であるから，憲法より下位の法形式による全ての法規の解釈適用に当たって，その指導原理となり得るものであることはいうまでもないが，私法上の行為の効力を直接規律するものではない。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":18,"official_answer":3}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[150,154]}},{"id":"yobi-2011-kenpo-q09-a","question_id":"yobi-2011-kenpo-q09","label":"ア","text":"大学は，その設置目的を達成するために必要な事項を実施する，自律的，包括的な権能を有していることから，単位の授与や専攻科修了の認定に係る係争は，一般市民法秩序と直接の関係を有すると認められる特段の事情のない限り，司法審査の対象とはならない。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":19,"official_answer":6}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[164,166]}},{"id":"yobi-2011-kenpo-q09-b","question_id":"yobi-2011-kenpo-q09","label":"イ","text":"政党の処分が党員の一般市民としての権利利益への侵害となり得る場合においても，その処分の当否の司法審査は，政党の自律的に定めた規範が公序良俗に反するなどの特段の事情のない限り，その規範に照らし適正な手続にのっとってされたかどうかの範囲で行われる。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":19,"official_answer":6}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[167,169]}},{"id":"yobi-2011-kenpo-q09-c","question_id":"yobi-2011-kenpo-q09","label":"ウ","text":"地方議会における自律的な法規範の実現については，内部規律の問題として自治的措置に任せるのが適当であるが，数日間に及ぶ議会への出席停止の懲罰は，議員の重大な権利行使に対する制限であり，単なる内部規律の問題に止まらないから，司法審査の対象となる。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":19,"official_answer":6}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[170,172]}},{"id":"yobi-2011-kenpo-q10-a","question_id":"yobi-2011-kenpo-q10","label":"ア","text":"憲法第８１条は，当事者間の具体的な権利義務ないし法律関係の存否に関する争訟事件を解決するのに必要な限度で，裁判所に違憲審査権を付与した規定である。したがって，裁判所にはいわゆる客観訴訟において違憲審査を行う権限はない。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":20,"official_answer":5}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[182,184]},"same_as":[{"id":"shiho-2011-kenpo-q18-a","exam":"司法","era":"H23","year":2011,"number":18,"label":"ア"}]},{"id":"yobi-2011-kenpo-q10-b","question_id":"yobi-2011-kenpo-q10","label":"イ","text":"憲法は国の最高法規であってこれに反する法律命令等はその効力を有さず，裁判官は憲法及び法律に拘束され，憲法を尊重擁護する義務を負う。したがって，最高裁判所に限らず下級裁判所の裁判官も違憲審査の権限を有する。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":20,"official_answer":5}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[185,187]},"same_as":[{"id":"shiho-2011-kenpo-q18-b","exam":"司法","era":"H23","year":2011,"number":18,"label":"イ"}]},{"id":"yobi-2011-kenpo-q10-c","question_id":"yobi-2011-kenpo-q10","label":"ウ","text":"憲法第８１条が「一切の法律，命令，規則又は処分」という場合の「処分」とは，統治機関の行為の意味である。したがって，これには行政機関の行政処分のみならず，裁判所の判決も含まれる。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":20,"official_answer":5}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[188,190]},"same_as":[{"id":"shiho-2011-kenpo-q18-c","exam":"司法","era":"H23","year":2011,"number":18,"label":"ウ"}]},{"id":"yobi-2011-kenpo-q11-a","question_id":"yobi-2011-kenpo-q11","label":"ア","text":"ａ．地方公共団体の制定する条例は，憲法が定める「地方自治の本旨」に基づき，憲法により制定する権能を定められた自治立法である。ｂ．条例により，住民の基本的人権に制限を課すことも可能であるが，憲法第１４条に照らし，このような制限が地域による差別を生ずることは憲法上許されない。[№21]","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[202,205]}},{"id":"yobi-2011-kenpo-q11-b","question_id":"yobi-2011-kenpo-q11","label":"イ","text":"ａ．地方自治法は，政策に関する住民投票制度を規定していないが，憲法の定める「地方自治の本旨」からして，地方公共団体が住民投票を行うことは認められる。ｂ．条例で住民投票制度を設け，「首長は，事務の執行に当たり，その結果を尊重するものとする」と定めた場合，首長には，住民投票の結果に従うべき法的義務がある。[№22]","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[206,209]}},{"id":"yobi-2011-kenpo-q11-c","question_id":"yobi-2011-kenpo-q11","label":"ウ","text":"ａ．条例が法律に違反するかどうかは，それぞれの趣旨，目的，内容及び効果を比較し，両者の内容に矛盾抵触するところがあるかどうかによって決するべきである。ｂ．地方公共団体が，法律と同一目的で同一の汚染物質について，条例でより厳しい排出基準を定めたとしても，その条例が直ちに法律に違反するとは言えない。[№23]","requires_context":false,"truth_at_exam":null,"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[210,213]}},{"id":"yobi-2011-kenpo-q12-a","question_id":"yobi-2011-kenpo-q12","label":"ア","text":"憲法改正国民投票制は，国民の憲法制定権力の思想を端的に具体化したものであるとの見解によれば，これを廃止することは，改正権の自己否定であり，国民主権の原理を揺るがす意味を持つので，憲法改正によっても国民投票制を廃止することは許されないこととなる。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":24,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[219,221]}},{"id":"yobi-2011-kenpo-q12-b","question_id":"yobi-2011-kenpo-q12","label":"イ","text":"憲法では，憲法改正には国民投票の「過半数の賛成」が必要であると規定されている。過半数の意味については，見解が分かれていたが，平成２２年５月に施行された「日本国憲法の改正手続に関する法律」では，投票総数（賛成票と反対票の合計）の過半数とされている。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":24,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[222,224]}},{"id":"yobi-2011-kenpo-q12-c","question_id":"yobi-2011-kenpo-q12","label":"ウ","text":"憲法では，憲法改正について国民の承認を得たときは，天皇は「国民の名で，この憲法と一体を成すものとして」公布すると規定されている。これは，憲法改正権が国民にあることを明確にし，改正された部分も他の部分と同様の最高法規としての効力を有することを意味する。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":24,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[225,227]}}],"explanations":[]}