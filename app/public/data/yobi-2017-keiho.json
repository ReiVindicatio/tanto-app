:{"partial_credit":null,"no_partial_credit":false,"raw_note":""},"status":{"voided":false,"all_correct":false,"errata":[]},"statements":["yobi-2017-keiho-q02-a","yobi-2017-keiho-q02-b","yobi-2017-keiho-q02-c","yobi-2017-keiho-q02-d","yobi-2017-keiho-q02-e"],"statement_truth_derivable":true,"provenance":{"question_pdf":"data/raw/予備試験/短答/H29-2017/刑法刑事訴訟法_問題.pdf","answer_pdf":"data/raw/予備試験/短答/H29-2017/刑法刑事訴訟法_正答.pdf","page":2,"line_range":[41,55],"extraction":"pdftotext"},"flags":[]},{"id":"yobi-2017-keiho-q03","exam":{"type":"yobi","year":2017,"era":"H29"},"subject":"keiho","number":3,"points":2,"format":"fill_blank","polarity":null,"exhaustive":false,"unordered":false,"stem":"次の【記述】中の①から④までの（ ）内から適切な語句を選んだ場合，その組合せとして正しいものは，後記１から５までのうちどれか。（解答欄は，[№４］）","context":[{"kind":"記述","text":"被害者の同意が問題となる場合としては，一般に以下のような分類がなされている。第１は，被害者の意思に反することが構成要件要素になっている場合であり，この類型においては，被害者の同意は構成要件該当性を阻却する。窃盗罪は，この類型に①（ａ．入る・ｂ．入らない）。第２は，被害者の同意の有無が犯罪の成立に影響を及ぼさない場合である。１３歳未満の者に対するわいせつ行為は，この類型に②（ｃ．入る・ｄ．入らない）。第３は，被害者の同意がある場合とない場合が分けて規定され，被害者の同意があると軽い方の罪が成立する場合である。業務上堕胎罪は，この類型に③（ｅ．入る・ｆ．入らない）。第４は，被害者の同意が行為の違法性を阻却する場合である。住居侵入罪の「侵入」を住居権者・管理権者の意思に反する立入りと解した場合，同罪は，この類型に④（ｇ．入る・ｈ．入らない）。"}],"sub_questions":[],"requires_context":true,"choices":[{"number":1,"text":"①ａ ②ｃ ③ｅ ④ｈ","blanks":[{"blank":1,"word":"ａ"},{"blank":2,"word":"ｃ"},{"blank":3,"word":"ｅ"},{"blank":4,"word":"ｈ"}]},{"number":2,"text":"①ａ ②ｃ ③ｆ ④ｈ","blanks":[{"blank":1,"word":"ａ"},{"blank":2,"word":"ｃ"},{"blank":3,"word":"ｆ"},{"blank":4,"word":"ｈ"}]},{"number":3,"text":"①ａ ②ｄ ③ｆ ④ｇ","blanks":[{"blank":1,"word":"ａ"},{"blank":2,"word":"ｄ"},{"blank":3,"word":"ｆ"},{"blank":4,"word":"ｇ"}]},{"number":4,"text":"①ｂ ②ｃ ③ｅ ④ｈ","blanks":[{"blank":1,"word":"ｂ"},{"blank":2,"word":"ｃ"},{"blank":3,"word":"ｅ"},{"blank":4,"word":"ｈ"}]},{"number":5,"text":"①ｂ ②ｄ ③ｆ ④ｇ","blanks":[{"blank":1,"word":"ｂ"},{"blank":2,"word":"ｄ"},{"blank":3,"word":"ｆ"},{"blank":4,"word":"ｇ"}]}],"answer_slots":[{"no":4,"official_answer":1}],"scoring":{"partial_credit":null,"no_partial_credit":false,"raw_note":""},"status":{"voided":false,"all_correct":false,"errata":[]},"statements":[],"statement_truth_derivable":false,"provenance":{"question_pdf":"data/raw/予備試験/短答/H29-2017/刑法刑事訴訟法_問題.pdf","answer_pdf":"data/raw/予備試験/短答/H29-2017/刑法刑事訴訟法_正答.pdf","page":3,"line_range":[57,76],"extraction":"pdftotext"},"flags":[]},{"id":"yobi-2017-keiho-q04","exam":{"type":"yobi","year":2017,"era":"H29"},"subject":"keiho","number":4,"points":2,"format":"combination","polarity":null,"exhaustive":false,"unordered":false,"stem":"わいせつ物頒布等の罪に関する次のアからオまでの各記述を判例の立場に従って検討し，甲に（ ）内の罪が成立しないものの組合せは，後記１から５までのうちどれか。（解答欄は，[№５］）","context":[],"sub_questions":[],"requires_context":false,"choices":[{"number":1,"text":"ア エ","labels":["ア","エ"]},{"number":2,"text":"ア オ","labels":["ア","オ"]},{"number":3,"text":"イ ウ","labels":["イ","ウ"]},{"number":4,"text":"イ エ","labels":["イ","エ"]},{"number":5,"text":"ウ オ","labels":["ウ","オ"]}],"answer_slots":[{"no":5,"official_answer":3}],"scoring":{"partial_credit":null,"no_partial_credit":false,"raw_note":""},"status":{"voided":false,"all_correct":false,"errata":[]},"statements":["yobi-2017-keiho-q04-a","yobi-2017-keiho-q04-b","yobi-2017-keiho-q04-c","yobi-2017-keiho-q04-d","yobi-2017-keiho-q04-e"],"statement_truth_derivable":false,"provenance":{"question_pdf":"data/raw/予備試験/短答/H29-2017/刑法刑事訴訟法_問題.pdf","answer_pdf":"data/raw/予備試験/短答/H29-2017/刑法刑事訴訟法_正答.pdf","page":3,"line_range":[77,98],"extraction":"pdftotext"},"flags":[]},{"id":"yobi-2017-keiho-q05","exam":{"type":"yobi","year":2017,"era":"H29"},"subject":"keiho","number":5,"points":2,"format":"combination","polarity":"incorrect","exhaustive":true,"unordered":false,"stem":"次の【事例】に関する後記アからエまでの各【記述】を判例の立場に従って検討し，誤っているものを全て選んだ場合の組合せは，後記１から５までのうちどれか。（解答欄は，[№６］）","context":[{"kind":"事例","text":"土木作業員甲及び乙は，現場監督者丙の監督の下で，Ｘ川に架かる鉄橋の橋脚を特殊なＡ鋼材を用いて補強する工事に従事していたが，作業に手間取り，工期が迫ってきたことから，甲及び乙の２人で相談した上で，より短期間で作業を終えることができる強度の弱いＢ鋼材を用いた補強工事を共同して行った。その結果，工期内に工事を終えることはできたものの，その後発生した豪雨の際，Ａ鋼材ではなくＢ鋼材を用いたことによる強度不足のために前記橋脚が崩落し，たまたま前記鉄橋上を走行していたＶ１運転のトラックがＸ川に転落し，Ｖ１が死亡した。なお，甲及び乙は同等の立場にあり，甲及び乙のいずれについても，Ｂ鋼材を工事に用いた場合に強度不足のために前記橋脚が崩落することを予見していなかったものの，その予見可能性があったものとする。"}],"sub_questions":[],"requires_context":true,"choices":[{"number":1,"text":"ア イ ウ","labels":["ア","イ","ウ"]},{"number":2,"text":"ア ウ エ","labels":["ア","ウ","エ"]},{"number":3,"text":"ア エ","labels":["ア","エ"]},{"number":4,"text":"イ ウ","labels":["イ","ウ"]},{"number":5,"text":"ウ エ","labels":["ウ","エ"]}],"answer_slots":[{"no":6,"official_answer":2}],"scoring":{"partial_credit":null,"no_partial_credit":false,"raw_note":""},"status":{"voided":false,"all_correct":false,"errata":[]},"statements":["yobi-2017-keiho-q05-a","yobi-2017-keiho-q05-b","yobi-2017-keiho-q05-c","yobi-2017-keiho-q05-d"],"statement_truth_derivable":true,"provenance":{"question_pdf":"data/raw/予備試験/短答/H29-2017/刑法刑事訴訟法_問題.pdf","answer_pdf":"data/raw/予備試験/短答/H29-2017/刑法刑事訴訟法_正答.pdf","page":4,"line_range":[100,126],"extraction":"pdftotext"},"flags":[]},{"id":"yobi-2017-keiho-q06","exam":{"type":"yobi","year":2017,"era":"H29"},"subject":"keiho","number":6,"points":2,"format":"single_choice","polarity":"incorrect","exhaustive":false,"unordered":false,"stem":"次の各【見解】に関する後記１から５までの各【記述】のうち，誤っているものはどれか。（解答欄は，[№７］）","context":[{"kind":"見解","text":"Ａ説：遺棄罪は，生命・身体に対する危険犯である。\nＢ説：遺棄罪は，生命に対する危険犯である。"}],"sub_questions":[],"requires_context":true,"choices":[],"answer_slots":[{"no":7,"official_answer":4}],"scoring":{"partial_credit":null,"no_partial_credit":false,"raw_note":""},"status":{"voided":false,"all_correct":false,"errata":[]},"statements":["yobi-2017-keiho-q06-1","yobi-2017-keiho-q06-2","yobi-2017-keiho-q06-3","yobi-2017-keiho-q06-4","yobi-2017-keiho-q06-5"],"statement_truth_derivable":true,"provenance":{"question_pdf":"data/raw/予備試験/短答/H29-2017/刑法刑事訴訟法_問題.pdf","answer_pdf":"data/raw/予備試験/短答/H29-2017/刑法刑事訴訟法_正答.pdf","page":4,"line_range":[127,146],"extraction":"pdftotext"},"flags":[]},{"id":"yobi-2017-keiho-q07","exam":{"type":"yobi","year":2017,"era":"H29"},"subject":"keiho","number":7,"po