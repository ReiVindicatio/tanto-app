":"H25","year":2013,"number":27,"label":"エ"}]},{"id":"yobi-2013-gyosei-q17-a","question_id":"yobi-2013-gyosei-q17","label":"ア","text":"特定の個人の病歴に関する情報が記録された行政文書の開示請求があった場合，当該行政文書に記録されている情報は不開示情報に該当するので不開示である旨を答えたのでは，そのことだけで当該個人の病歴の存在が明らかになってしまうため，行政機関の長は，当該行政文書の存否を明らかにしないで当該開示請求を拒否することができる。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":35,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[334,337]},"same_as":[{"id":"shiho-2013-gyosei-q29-a","exam":"司法","era":"H25","year":2013,"number":29,"label":"ア"}]},{"id":"yobi-2013-gyosei-q17-b","question_id":"yobi-2013-gyosei-q17","label":"イ","text":"行政機関の長は，開示請求に係る行政文書に情報公開法第５条各号所定の不開示情報が記録されている場合には，公益上特に必要があると認めるときであっても，当該行政文書を開示することができない。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":36,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[338,340]},"same_as":[{"id":"shiho-2013-gyosei-q29-b","exam":"司法","era":"H25","year":2013,"number":29,"label":"イ"}]},{"id":"yobi-2013-gyosei-q17-c","question_id":"yobi-2013-gyosei-q17","label":"ウ","text":"行政文書の開示請求に対する不開示決定のうち，当該行政文書を保有していないことを理由とするものについても，行政不服審査法に基づく不服申立てをすることができる。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":37,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[341,342]},"same_as":[{"id":"shiho-2013-gyosei-q29-c","exam":"司法","era":"H25","year":2013,"number":29,"label":"ウ"}]},{"id":"yobi-2013-gyosei-q17-d","question_id":"yobi-2013-gyosei-q17","label":"エ","text":"行政文書の開示請求に対する不開示決定の取消訴訟において，不開示とされた行政文書を目的とする検証を被告に受忍義務を負わせて行うことは原則として許されないが，原告が検証への立会権を放棄した場合には，例外的に許される。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":38,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[343,345]},"same_as":[{"id":"shiho-2013-gyosei-q29-d","exam":"司法","era":"H25","year":2013,"number":29,"label":"エ"}]},{"id":"yobi-2013-gyosei-q18-a","question_id":"yobi-2013-gyosei-q18","label":"ア","text":"処分の取消しの訴えは，当該処分の取消しを求めるにつき法律上の利益を有する者及び直接的かつ重大な事実上の利益を有する者に限り，提起することができる。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":39,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[356,357]}},{"id":"yobi-2013-gyosei-q18-b","question_id":"yobi-2013-gyosei-q18","label":"イ","text":"処分の取消しの訴えの原告適格を判断するに当たっては，当該処分の根拠法令と目的を共通にする関係法令があるときは，その趣旨及び目的をも参酌すべきである。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":40,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[358,359]}},{"id":"yobi-2013-gyosei-q18-c","question_id":"yobi-2013-gyosei-q18","label":"ウ","text":"処分の取消しの訴えの原告適格を判断するに当たっては，当該処分が根拠法令に違反してされた場合に害されることとなる利益の内容及び性質並びにこれが害される態様及び程度をも勘案すべきである。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":41,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[360,362]}},{"id":"yobi-2013-gyosei-q18-d","question_id":"yobi-2013-gyosei-q18","label":"エ","text":"処分の取消しの訴えの原告適格に関する行政事件訴訟法第９条第２項の規定は，処分の差止めの訴えの原告適格の判断について，準用されている。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":42,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[363,364]}},{"id":"yobi-2013-gyosei-q19-a","question_id":"yobi-2013-gyosei-q19","label":"ア","text":"本件訴訟において，Ａが本件確認をするに当たり先行処分の適法性につき審査を尽くしたことが認められる場合は，先行処分が違法であることは，本件確認の取消事由とならない。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":43,"official_answer":6}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[378,379]},"same_as":[{"id":"shiho-2013-gyosei-q32-a","exam":"司法","era":"H25","year":2013,"number":32,"label":"ア"}]},{"id":"yobi-2013-gyosei-q19-b","question_id":"yobi-2013-gyosei-q19","label":"イ","text":"本件訴訟において，被告であるＡは，先行処分の適法性の審理のために必要があると考えた場合は，裁判所に対し，先行処分をした行政庁である区長Ｂを本件訴訟に参加させることを求める申立てを，適法にすることができる。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":43,"official_answer":6}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[380,382]},"same_as":[{"id":"shiho-2013-gyosei-q32-b","exam":"司法","era":"H25","year":2013,"number":32,"label":"イ"}]},{"id":"yobi-2013-gyosei-q19-c","question_id":"yobi-2013-gyosei-q19","label":"ウ","text":"本件訴訟において，本件確認を取り消す判決が確定した場合には，当該判決は，本件確認をしたＡのみを拘束する。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":43,"official_answer":6}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[383,384]},"same_as":[{"id":"shiho-2013-gyosei-q32-c","exam":"司法","era":"H25","year":2013,"number":32,"label":"ウ"}]},{"id":"yobi-2013-gyosei-q20-a","question_id":"yobi-2013-gyosei-q20","label":"ア","text":"処分の差止めの訴えについて行政事件訴訟法第３７条の４第１項所定の「重大な損害を生ずるおそれ」があると認められるためには，処分がされることにより生ずるおそれのある損害が，処分がされた後に取消訴訟又は無効確認訴訟を提起して執行停止の決定を受けることなどにより容易に救済を受けることができるものではなく，処分がされる前に差止めを命ずる方法によるのでなければ救済を受けることが困難なものであることを要する。","requires_context":true,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":44,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[409,413]}},{"id":"yobi-2013-gyosei-q20-b","question_id":"yobi-2013-gyosei-q20","label":"イ","text":"教職員が本件職務命令の違反を理由とする懲戒処分の差止めを求める訴えについては，処分の取消訴訟等を提起して執行停止の決定を受けることにより容易に救済を受けることができるから，前記⑴，⑵などの事情があるからといって，行政事件訴訟法第３７条の４第１項所定の「重大な損害を生ずるおそれ」があるということはできない。","requires_context":true,"truth_at_exam":{"value":false,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":45,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[414,417]}},{"id":"yobi-2013-gyosei-q20-c","question_id":"yobi-2013-gyosei-q20","label":"ウ","text":"教職員が本件職務命令に基づく義務の不存在の確認を求める訴えは，本件職務命令の違反を理由としてされる蓋然性のある懲戒処分の差止めの訴えを法定の類型の抗告訴訟として適法に提起することができ，その本案において当該義務の存否が判断の対象となるという事情の下では，上記懲戒処分の予防を目的とするいわゆる無名抗告訴訟としては，他に適当な争訟方法があるものとして，不適法である。","requires_context":true,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":46,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[418,422]}},{"id":"yobi-2013-gyosei-q20-d","question_id":"yobi-2013-gyosei-q20","label":"エ","text":"教職員が本件職務命令に基づく義務の不存在の確認を求める訴えは，前記⑴，⑵などの事情の下では，本件職務命令の違反を理由とする行政処分以外の処遇上の不利益の予防を目的とする公法上の法律関係に関する確認の訴えとして，確認の利益がある。","requires_context":true,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":47,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[423,425]}},{"id":"yobi-2013-gyosei-q21-a","question_id":"yobi-2013-gyosei-q21","label":"ア","text":"処分の効力の全部を停止する旨の決定が確定した場合において，当該決定は，第三者に対しても効力を有する。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":48,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[434,435]},"same_as":[{"id":"shiho-2013-gyosei-q36-a","exam":"司法","era":"H25","year":2013,"number":36,"label":"ア"}]},{"id":"yobi-2013-gyosei-q21-b","question_id":"yobi-2013-gyosei-q21","label":"イ","text":"処分の効力の全部を停止する旨の決定が確定した場合において，相手方は，本案の判決が確定するまでは，事情のいかんにかかわらず，当該決定の取消しを求める申立てを適法にすることができない。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":49,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[436,438]},"same_as":[{"id":"shiho-2013-gyosei-q36-b","exam":"司法","era":"H25","year":2013,"number":36,"label":"イ"}]},{"id":"yobi-2013-gyosei-q21-c","question_id":"yobi-2013-gyosei-q21","label":"ウ","text":"処分の取消しの訴えの提起があった場合において，当該処分，当該処分の執行又は手続の続行により生ずる重大な損害を避けるため緊急の必要があるときは，裁判所は，申立てにより，仮に行政庁がこれらの停止その他の適切な措置をすべき旨を命ずることができる。","requires_context":false,"truth_at_exam":{"value":false,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":50,"official_answer":2}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[439,441]},"same_as":[{"id":"shiho-2013-gyosei-q36-c","exam":"司法","era":"H25","year":2013,"number":36,"label":"ウ"}]},{"id":"yobi-2013-gyosei-q21-d","question_id":"yobi-2013-gyosei-q21","label":"エ","text":"裁判所は，仮の差止めを命ずる決定をする場合は，常にあらかじめ相手方の意見を聴かなければならない。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"true_false_each","basis":"direct","derived_from":{"slots":[{"no":51,"official_answer":1}]}},"truth_current":{"status":"unreviewed","value":null,"basis":null,"law_change_refs":[],"reviewed_by":null,"reviewed_at":null},"tags":{"articles":[],"topics":[]},"provenance":{"line_range":[442,443]},"same_as":[{"id":"shiho-2013-gyosei-q36-d","exam":"司法","era":"H25","year":2013,"number":36,"label":"エ"}]},{"id":"yobi-2013-gyosei-q22-a","question_id":"yobi-2013-gyosei-q22","label":"ア","text":"国家賠償法第１条第１項にいう「公権力の行使」には，公立学校における教師の教育活動も含まれる。","requires_context":false,"truth_at_exam":{"value":true,"derivation":"mark_combination","basis":"direct","derived_from":{"slots":[{"no":52,"official_answer":3}]}},"truth_current":{