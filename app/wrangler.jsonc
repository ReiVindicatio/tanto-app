// Cloudflare Workers の設定（T002・T003）。
// /api/* は Worker（worker/index.ts）が処理し、それ以外は dist/ の静的ファイル（アプリ）を返す。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tantan",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/audio/*"]
  },
  // 聞き流しの音声（T058）。pipeline/tts_upload.py で上げる
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "tantan-audio" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tantan",
      "database_id": "fd7d210a-2a7e-434c-867b-542501c574b0",
      "migrations_dir": "migrations"
    }
  ],
  // 使いすぎの制限（T040：見えない安全網）。数は Cloudflare の拠点ごとの概算。
  // 今の正常な使い方は1分に1〜3回（T021）なので、人の手ではまず届かない。超えても画面には出さず、端末からあとで送り直す
  "ratelimits": [
    { "name": "RL_IP", "namespace_id": "4001", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_USER", "namespace_id": "4002", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    // Firebase の ID トークンの検証に使う（秘密ではない）
    "FIREBASE_PROJECT_ID": "tantan-adce9",
    // 本番。テスト用ログイン（AUTH_MODE=test）は手元の開発環境でだけ --var で渡す
    "ENVIRONMENT": "production"
  }
}
